# Generated by mwan from /etc/mwan/network.json. Do not edit.
[Match]
Name=enmbrains0

[Network]
DHCP=yes
IPv6AcceptRA=yes
IPv4Forwarding=yes
IPv6Forwarding=yes

[DHCPv4]
RouteMetric=5000

[DHCPv6]
DUIDType=link-layer-time
DUIDRawData=00:01:2a:5b:3c:4d:02:00:5e:00:53:02
PrefixDelegationHint=::/56
WithoutRA=solicit
UseDelegatedPrefix=yes

[IPv6PrefixDelegation]
RouterLifetimeSec=1800

[IPv6AcceptRA]
RouteMetric=5000
