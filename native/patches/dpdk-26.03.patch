+static int32_t
+ulp_rte_gre_rx_raw_encap_act_handler(const struct rte_flow_action *action_item,
+				  struct ulp_rte_parser_params *params)
+{
+	static const struct rte_ether_addr source = {
+		.addr_bytes = { 0x02, 0x57, 0x50, 0x04, 0x77, 0x03 }
+	};
+	static const struct rte_ether_addr destination = {
+		.addr_bytes = { 0x02, 0x57, 0x50, 0x04, 0, 0 }
+	};
+	const struct rte_flow_action_raw_encap *raw = action_item->conf;
+	struct rte_flow_item_eth eth = {0};
+
+	if (!raw || !raw->data || raw->size != sizeof(eth.hdr) ||
+	    !ULP_BITMAP_ISSET(params->act_bitmap.bits, BNXT_ULP_ACT_BIT_GRE_RX_DECAP) ||
+	    ULP_BITMAP_ISSET(params->act_bitmap.bits, BNXT_ULP_ACT_BIT_GRE_RX_ENCAP))
+		goto unsupported;
+	if (raw->preserve && ulp_bitmap_notzero(raw->preserve, raw->size))
+		goto unsupported;
+	memcpy(&eth.hdr, raw->data, sizeof(eth.hdr));
+	if (eth.hdr.ether_type != RTE_BE16(RTE_ETHER_TYPE_IPV6) ||
+	    !rte_is_same_ether_addr(&eth.hdr.src_addr, &source) ||
+	    !rte_is_same_ether_addr(&eth.hdr.dst_addr, &destination))
+		goto unsupported;
+	ulp_rte_enc_eth_hdr_handler(params, &eth);
+	ULP_BITMAP_SET(params->act_bitmap.bits, BNXT_ULP_ACT_BIT_GRE_RX_ENCAP);
+	return BNXT_TF_RC_SUCCESS;
+
+unsupported:
+	BNXT_DRV_DBG(ERR, "GRE RX RAW_ENCAP requires a 14-byte IPv6 Ethernet "
+		     "header with proof source and native VF destination MACs\n");
+	return BNXT_TF_RC_PARSE_ERR;
+}
