+	struct rte_ether_hdr ethernet;
+
+	if (!raw || !raw->data || raw->size != sizeof(ethernet)) {
+		BNXT_DRV_DBG(ERR, "GRE RAW_DECAP requires one Ethernet header\n");
+		return BNXT_TF_RC_ERROR;
+	}
+	memcpy(&ethernet, raw->data, sizeof(ethernet));
+	if (ethernet.ether_type != rte_cpu_to_be_16(RTE_ETHER_TYPE_IPV6)) {
+		BNXT_DRV_DBG(ERR, "GRE RAW_DECAP requires EtherType IPv6\n");
+		return BNXT_TF_RC_ERROR;
