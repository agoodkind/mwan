+int bnxt_hwrm_func_qcfg_mac_addr(struct bnxt *bp, uint16_t fid,
+			       struct rte_ether_addr *mac)
+{
+	struct hwrm_func_qcfg_input req = {0};
+	struct hwrm_func_qcfg_output *resp;
+	struct rte_ether_addr address;
+	uint16_t response_length;
+	int rc;
+
+	if (!bp || !mac || fid >= 0xfff8)
+		return -EINVAL;
+
+	resp = bp->hwrm_cmd_resp_addr;
+	HWRM_PREP(&req, HWRM_FUNC_QCFG, BNXT_USE_CHIMP_MB);
+	req.fid = rte_cpu_to_le_16(fid);
+	rc = bnxt_hwrm_send_message(bp, &req, sizeof(req), BNXT_USE_CHIMP_MB);
+	HWRM_CHECK_RESULT();
+
+	response_length = rte_le_to_cpu_16(resp->resp_len);
+	if (response_length < offsetof(struct hwrm_func_qcfg_output, mac_address) +
+	    sizeof(resp->mac_address) + 1 || response_length > bp->max_resp_len) {
+		PMD_DRV_LOG_LINE(ERR, "FUNC_QCFG fid=%u invalid response length=%u",
+				 fid, response_length);
+		rc = -EPROTO;
+		goto unlock;
+	}
+	if (resp->req_type != req.req_type || resp->seq_id != req.seq_id ||
+	    ((uint8_t *)resp)[response_length - 1] != HWRM_RESP_VALID_KEY ||
+	    rte_le_to_cpu_16(resp->fid) != fid) {
+		PMD_DRV_LOG_LINE(ERR, "FUNC_QCFG fid=%u invalid response fid=%u",
+				 fid, rte_le_to_cpu_16(resp->fid));
+		rc = -EPROTO;
+		goto unlock;
+	}
+
+	memcpy(address.addr_bytes, resp->mac_address, RTE_ETHER_ADDR_LEN);
+	if (!rte_is_valid_assigned_ether_addr(&address)) {
+		PMD_DRV_LOG_LINE(ERR, "FUNC_QCFG fid=%u returned invalid unicast MAC", fid);
+		rc = -EADDRNOTAVAIL;
+		goto unlock;
+	}
+	*mac = address;
+
+unlock:
+	HWRM_UNLOCK();
+	return rc;
+}
