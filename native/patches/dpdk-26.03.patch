+static void
+bnxt_ulp_ctrl_tx_ilt_log(struct bnxt *bp, const char *stage, const uint8_t *data)
+{
+	if (!getenv("BNXT_REP_ILT_DIAG"))
+		return;
+	BNXT_DRV_DBG(NOTICE,
+		"ILT_DIAG stage=%s port=%u dir=%u index=%u "
+		"bytes=%02x%02x%02x%02x%02x%02x%02x%02x\n",
+		stage, bp->eth_dev->data->port_id, TF_DIR_TX, bp->ctrl_tx_ilt.index,
+		data[0], data[1], data[2], data[3],
+		data[4], data[5], data[6], data[7]);
+}
+
+static int32_t
+bnxt_ulp_ctrl_tx_ilt_save(struct bnxt *bp)
+{
+	struct tf_get_if_tbl_entry_parms parms = { 0 };
+	struct bnxt_rep_ilt_entry saved = { 0 };
+	uint32_t ifindex;
+	uint16_t svif;
+	struct tf *tfp;
+	int32_t rc;
+
+	if (!BNXT_CHIP_P5(bp))
+		return 0;
+	if (bp->ctrl_tx_ilt.valid)
+		return -EBUSY;
+	tfp = bnxt_ulp_cntxt_tfp_get(bp->ulp_ctx, BNXT_ULP_SESSION_TYPE_DEFAULT);
+	if (!tfp)
+		return -EINVAL;
+	rc = ulp_port_db_dev_port_to_ulp_index(bp->ulp_ctx,
+					     bp->eth_dev->data->port_id, &ifindex);
+	if (rc)
+		return rc;
+	rc = ulp_port_db_svif_get(bp->ulp_ctx, ifindex, BNXT_ULP_DRV_FUNC_SVIF,
+				 &svif);
+	if (rc)
+		return rc;
+	if (svif == BNXT_SVIF_INVALID)
+		return -EINVAL;
+	parms.dir = TF_DIR_TX;
+	parms.type = TF_IF_TBL_TYPE_ILT;
+	parms.idx = svif;
+	parms.data = saved.data;
+	parms.data_sz_in_bytes = sizeof(saved.data);
+	rc = tf_get_if_tbl_entry(tfp, &parms);
+	if (rc)
+		return rc;
+	saved.index = svif;
+	saved.valid = true;
+	bp->ctrl_tx_ilt = saved;
+	bnxt_ulp_ctrl_tx_ilt_log(bp, "controller-before-default", saved.data);
+	return 0;
+}
+
+/* The void lifecycle reports restore failures and retains the saved entry. */
+static void
+bnxt_ulp_ctrl_tx_ilt_restore(struct bnxt *bp)
+{
+	struct tf_set_if_tbl_entry_parms set = { 0 };
+	struct tf_get_if_tbl_entry_parms get = { 0 };
+	uint8_t actual[BNXT_REP_ILT_ENTRY_SIZE];
+	struct tf *tfp;
+	int32_t rc;
+
+	if (!BNXT_CHIP_P5(bp) || !bp->ctrl_tx_ilt.valid)
+		return;
+	tfp = bnxt_ulp_cntxt_tfp_get(bp->ulp_ctx, BNXT_ULP_SESSION_TYPE_DEFAULT);
+	if (!tfp) {
+		rc = -EINVAL;
+		goto error;
+	}
+	set.dir = TF_DIR_TX;
+	set.type = TF_IF_TBL_TYPE_ILT;
+	set.idx = bp->ctrl_tx_ilt.index;
+	set.data = bp->ctrl_tx_ilt.data;
+	set.data_sz_in_bytes = sizeof(bp->ctrl_tx_ilt.data);
+	rc = tf_set_if_tbl_entry(tfp, &set);
+	if (rc)
+		goto error;
+	get.dir = TF_DIR_TX;
+	get.type = TF_IF_TBL_TYPE_ILT;
+	get.idx = bp->ctrl_tx_ilt.index;
+	get.data = actual;
+	get.data_sz_in_bytes = sizeof(actual);
+	rc = tf_get_if_tbl_entry(tfp, &get);
+	if (rc)
+		goto error;
+	if (memcmp(actual, bp->ctrl_tx_ilt.data, sizeof(actual))) {
+		bnxt_ulp_ctrl_tx_ilt_log(bp, "controller-restore-mismatch", actual);
+		rc = -EIO;
+		goto error;
+	}
+	bnxt_ulp_ctrl_tx_ilt_log(bp, "controller-restore-readback", actual);
+	bp->ctrl_tx_ilt.valid = false;
+	return;
+error:
+	BNXT_DRV_DBG(ERR,
+		"Controller TX ILT restore failed port=%u index=%u rc=%d; "
+		"saved snapshot retained\n",
+		bp->eth_dev->data->port_id, bp->ctrl_tx_ilt.index, rc);
+}
