+		"resp_type=%#x seq=%u tunnel_id=%u",
+		target_fid, req.tunnel_type, rc, firmware_error, error_info,
+		response_length, reply_valid, rte_le_to_cpu_16(resp->req_type),
+		rte_le_to_cpu_16(resp->seq_id), rte_le_to_cpu_16(resp->tunnel_dst_port_id));
+	HWRM_UNLOCK();
+	if (rc)
+		return rc;
+	if (firmware_error)
+		return firmware_error;
+	if (!reply_valid)
+		return -EPROTO;
+	if (error_info == HWRM_TUNNEL_DST_PORT_ALLOC_OUTPUT_ERROR_INFO_ERR_ALLOCATED ||
+	    error_info == HWRM_TUNNEL_DST_PORT_ALLOC_OUTPUT_ERROR_INFO_ERR_ENABLED)
+		return -EALREADY;
+	if (error_info != HWRM_TUNNEL_DST_PORT_ALLOC_OUTPUT_ERROR_INFO_SUCCESS)
+		return -EIO;
+	return 0;
+}
+
+static int
+bnxt_hwrm_gre_rx_poc_free(struct bnxt *bp)
+{
+	struct hwrm_tunnel_dst_port_free_input req = {0};
+	struct hwrm_tunnel_dst_port_free_output *resp = bp->hwrm_cmd_resp_addr;
+	uint16_t response_length, firmware_error;
+	uint8_t error_info;
+	bool reply_valid;
+	int rc;
+
+	HWRM_PREP(&req, HWRM_TUNNEL_DST_PORT_FREE, BNXT_USE_CHIMP_MB);
+	req.target_id = rte_cpu_to_le_16(bp->gre_rx_poc_target_fid);
+	req.tunnel_type = HWRM_TUNNEL_DST_PORT_FREE_INPUT_TUNNEL_TYPE_GRE;
+	req.tunnel_next_proto = 0;
+	req.tunnel_dst_port_id = 0;
+	rc = bnxt_hwrm_send_message(bp, &req, sizeof(req), BNXT_USE_CHIMP_MB);
+	response_length = rte_le_to_cpu_16(resp->resp_len);
+	firmware_error = rte_le_to_cpu_16(resp->error_code);
+	error_info = resp->error_info;
+	reply_valid = !rc && !firmware_error && response_length >= sizeof(*resp) &&
+		rte_le_to_cpu_16(resp->req_type) == HWRM_TUNNEL_DST_PORT_FREE &&
+		resp->seq_id == req.seq_id && resp->valid;
+	PMD_DRV_LOG_LINE(NOTICE,
+		"GRE_RX_POC free target_fid=%u type=%#x next_proto=0 tunnel_id=0 "
+		"rc=%d fw_error=%#x error_info=%#x resp_len=%u reply_valid=%u "
+		"resp_type=%#x seq=%u",
+		bp->gre_rx_poc_target_fid, req.tunnel_type, rc, firmware_error,
+		error_info, response_length, reply_valid,
+		rte_le_to_cpu_16(resp->req_type), rte_le_to_cpu_16(resp->seq_id));
+	HWRM_UNLOCK();
+	if (rc)
+		return rc;
+	if (firmware_error)
+		return firmware_error;
+	if (!reply_valid)
+		return -EPROTO;
+	if (error_info != HWRM_TUNNEL_DST_PORT_FREE_OUTPUT_ERROR_INFO_SUCCESS)
+		return -EIO;
+	return 0;
+}
+
+static void
+bnxt_hwrm_gre_rx_poc_start(struct bnxt *bp)
+{
+	const char *value = getenv("BNXT_GRE_RX_POC");
+	uint8_t baseline_status, after_status;
+	uint16_t target_fid;
+	int rc, query_rc;
+
+	if (!value || strcmp(value, "1") != 0 || bp->gre_rx_poc_owned)
+		return;
+	if (!BNXT_CHIP_P5(bp) || !BNXT_VF_IS_TRUSTED(bp) || !bp->parent ||
+	    bp->parent->fid == BNXT_PF_FID_INVALID || bp->parent->fid > 0xfff8) {
+		PMD_DRV_LOG_LINE(ERR,
+			"GRE_RX_POC requires Thor trusted VF and a valid actual parent PF FID");
+		return;
+	}
+	target_fid = bp->fw_fid;
+	rc = bnxt_hwrm_gre_rx_diag(bp, target_fid, 0, &baseline_status);
+	if (rc) {
+		PMD_DRV_LOG_LINE(ERR, "GRE_RX_POC baseline query failed rc=%d", rc);
+		return;
+	}
+	if (baseline_status & HWRM_TUNNEL_DST_PORT_QUERY_OUTPUT_STATUS_FUNC_LEVEL) {
+		PMD_DRV_LOG_LINE(NOTICE,
+			"GRE_RX_POC target_fid=%u already enabled; allocation skipped",
+			target_fid);
+		return;
+	}
+	rc = bnxt_hwrm_gre_rx_poc_alloc(bp, target_fid);
+	if (!rc) {
+		bp->gre_rx_poc_target_fid = target_fid;
+		bp->gre_rx_poc_baseline_status = baseline_status;
+		bp->gre_rx_poc_owned = true;
+	}
+	query_rc = bnxt_hwrm_gre_rx_diag(bp, target_fid, 0, &after_status);
+	PMD_DRV_LOG_LINE(NOTICE,
+		"GRE_RX_POC after_alloc target_fid=%u alloc_rc=%d owned=%u "
+		"query_rc=%d",
+		target_fid, rc, bp->gre_rx_poc_owned, query_rc);
+	if (query_rc) {
+		PMD_DRV_LOG_LINE(ERR,
+			"GRE_RX_POC cannot verify parser status after allocation");
+	} else if (!bp->gre_rx_poc_owned &&
+		   (after_status & HWRM_TUNNEL_DST_PORT_QUERY_OUTPUT_STATUS_FUNC_LEVEL)) {
+		PMD_DRV_LOG_LINE(ERR,
+			"GRE_RX_POC target became enabled without confirmed ownership; "
+			"automatic free is unavailable");
+	} else if (bp->gre_rx_poc_owned &&
+		   !(after_status & HWRM_TUNNEL_DST_PORT_QUERY_OUTPUT_STATUS_FUNC_LEVEL)) {
+		PMD_DRV_LOG_LINE(ERR,
+			"GRE_RX_POC allocation succeeded but function parsing remains disabled");
+	}
+}
+
+static void
+bnxt_hwrm_gre_rx_poc_stop(struct bnxt *bp)
+{
+	uint8_t after_status;
+	int rc, query_rc;
+
+	if (!bp->gre_rx_poc_owned)
+		return;
+	rc = bnxt_hwrm_gre_rx_poc_free(bp);
+	if (!rc)
+		bp->gre_rx_poc_owned = false;
+	query_rc = bnxt_hwrm_gre_rx_diag(bp, bp->gre_rx_poc_target_fid, 0,
+				       &after_status);
+	PMD_DRV_LOG_LINE(NOTICE,
+		"GRE_RX_POC after_free target_fid=%u free_rc=%d owned=%u query_rc=%d",
+		bp->gre_rx_poc_target_fid, rc, bp->gre_rx_poc_owned, query_rc);
+	if (rc || query_rc) {
+		PMD_DRV_LOG_LINE(ERR,
+			"GRE_RX_POC rollback is unconfirmed before driver unregister");
+	} else if (after_status != bp->gre_rx_poc_baseline_status) {
+		PMD_DRV_LOG_LINE(ERR,
+			"GRE_RX_POC parser status differs from baseline: before=%#x after=%#x",
+			bp->gre_rx_poc_baseline_status, after_status);
+	}
+}
