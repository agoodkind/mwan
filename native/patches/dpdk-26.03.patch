+	memcpy(&ipv4, raw->data + sizeof(eth), sizeof(ipv4));
+	memcpy(&gre, raw->data + sizeof(eth) + sizeof(ipv4), sizeof(gre));
+	if (eth.ether_type != RTE_BE16(RTE_ETHER_TYPE_IPV4) ||
+	    ipv4.version_ihl != RTE_IPV4_VHL_DEF || ipv4.next_proto_id != IPPROTO_GRE ||
