+int32_t
+ulp_rte_raw_decap_act_handler(const struct rte_flow_action *action_item,
+			    struct ulp_rte_parser_params *params)
+{
+	const struct rte_flow_action_raw_decap *raw = action_item->conf;
+
+	if (raw && raw->size == sizeof(struct rte_ether_hdr))
+		return ulp_rte_gre_raw_decap_act_handler(action_item, params);
+	if (raw && raw->size == ULP_NAT64_UDP_DECAP_SIZE)
+		return ulp_rte_nat64_udp_decap_act_handler(action_item, params);
+	if (raw && raw->size == ULP_NAT64_L3_DECAP_SIZE)
+		return ulp_rte_nat64_l3_decap_act_handler(action_item, params);
+	if (raw && raw->size == ULP_NAT46_L3_DECAP_SIZE)
+		return ulp_rte_nat46_l3_decap_act_handler(action_item, params);
+	if (raw && raw->size == ULP_GRE_RX_DECAP_SIZE)
+		return ulp_rte_gre_rx_raw_decap_act_handler(action_item, params);
+	BNXT_DRV_DBG(ERR, "RAW_DECAP requires Ethernet[/IPv4/GRE] for GRE or "
+		     "Ethernet/IPv6[/UDP] or Ethernet/IPv4 for NAT64\n");
+	return BNXT_TF_RC_PARSE_ERR;
+}
+
+int32_t
+ulp_rte_raw_encap_act_handler(const struct rte_flow_action *action_item,
+			    struct ulp_rte_parser_params *params)
+{
+	const struct rte_flow_action_raw_encap *raw = action_item->conf;
+
+	if (raw && raw->size == sizeof(struct rte_ether_hdr) +
+	    sizeof(struct rte_ipv4_hdr) + sizeof(struct rte_flow_item_gre))
+		return ulp_rte_gre_raw_encap_act_handler(action_item, params);
+	if (raw && raw->size == ULP_NAT64_UDP_ENCAP_SIZE)
+		return ulp_rte_nat64_udp_encap_act_handler(action_item, params);
+	if (raw && raw->size == ULP_NAT64_L3_ENCAP_SIZE)
+		return ulp_rte_nat64_l3_encap_act_handler(action_item, params);
+	if (raw && raw->size == ULP_NAT46_L3_ENCAP_SIZE)
+		return ulp_rte_nat46_l3_encap_act_handler(action_item, params);
+	if (raw && raw->size == sizeof(struct rte_ether_hdr))
+		return ulp_rte_gre_rx_raw_encap_act_handler(action_item, params);
+	BNXT_DRV_DBG(ERR, "RAW_ENCAP requires Ethernet for GRE RX, Ethernet/IPv4/GRE or "
+		     "Ethernet/IPv4[/UDP] or Ethernet/IPv6\n");
+	return BNXT_TF_RC_PARSE_ERR;
+}
