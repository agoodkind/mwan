+int
+rte_pmd_bnxt_rep_role_set(uint16_t port_id, enum rte_pmd_bnxt_rep_role role)
+{
+	struct rte_eth_dev *dev;
+	struct bnxt_representor *vfr;
+	struct bnxt *bp;
+	int rc;
+
+	RTE_ETH_VALID_PORTID_OR_ERR_RET(port_id, -ENODEV);
+	if (role != RTE_PMD_BNXT_REP_ROLE_DATA &&
+	    role != RTE_PMD_BNXT_REP_ROLE_KERNEL &&
+	    role != RTE_PMD_BNXT_REP_ROLE_DIRECT_DATA)
+		return -EINVAL;
+	dev = &rte_eth_devices[port_id];
+	if (!is_bnxt_supported(dev) || !rte_eth_dev_is_repr(dev))
+		return -ENOTSUP;
+	vfr = dev->data->dev_private;
+	if (!vfr->parent_dev || !vfr->parent_dev->data ||
+	    !vfr->parent_dev->data->dev_private)
+		return -ENODEV;
+	bp = vfr->parent_dev->data->dev_private;
+	if (!BNXT_CHIP_P5(bp) || !BNXT_TRUFLOW_EN(bp) ||
+	    (!BNXT_PF(bp) && !BNXT_VF_IS_TRUSTED(bp)) ||
+	    BNXT_REP_PF(vfr) || BNXT_REP_BASED_PF(vfr) ||
+	    vfr->fw_fid == bp->fw_fid)
+		return -ENOTSUP;
+	if (dev->data->dev_started || vfr->registration_only ||
+	    vfr->vfr_tx_cfa_action || vfr->vf_rx_ilt.valid ||
