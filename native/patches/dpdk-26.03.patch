+static int32_t
+ulp_rte_nat64_chain_actions_check(const struct rte_flow_action *actions,
+				struct ulp_rte_parser_params *params)
+{
+	const struct rte_flow_action *action;
+	const struct rte_flow_action_jump *jump;
+	const uint8_t *source, *destination;
+	uint64_t ipv6_bits = BNXT_ULP_ACT_BIT_SET_IPV6_SRC |
+		BNXT_ULP_ACT_BIT_SET_IPV6_DST;
+	uint32_t source_actions = 0, destination_actions = 0;
+	uint32_t count_actions = 0, jump_actions = 0;
+	uint32_t prefix_size = RTE_IPV6_ADDR_SIZE - sizeof(rte_be32_t);
+	uint8_t protocol;
+	bool jump_seen = false;
+
+	if (!(params->act_bitmap.bits & ipv6_bits))
+		return BNXT_TF_RC_SUCCESS;
+	for (action = actions; action->type != RTE_FLOW_ACTION_TYPE_END; action++) {
+		if (action->type == RTE_FLOW_ACTION_TYPE_JUMP)
+			break;
+	}
+	if (action->type == RTE_FLOW_ACTION_TYPE_END)
+		return BNXT_TF_RC_SUCCESS;
+	if (ULP_COMP_FLD_IDX_RD(params, BNXT_ULP_CF_IDX_O_L3_PROTO_ID) == IPPROTO_UDP)
+		protocol = IPPROTO_UDP;
+	else if (ULP_COMP_FLD_IDX_RD(params, BNXT_ULP_CF_IDX_O_L3_PROTO_ID) == IPPROTO_TCP)
+		protocol = IPPROTO_TCP;
+	else
+		goto unsupported;
+	if (ulp_rte_nat64_pattern_check(params, protocol, false) ||
+	    ulp_rte_nat64_native_ingress_check(params))
+		goto unsupported;
+	for (action = actions; action->type != RTE_FLOW_ACTION_TYPE_END; action++) {
+		switch (action->type) {
+		case RTE_FLOW_ACTION_TYPE_VOID:
+			break;
+		case RTE_FLOW_ACTION_TYPE_SET_IPV6_SRC:
+			if (jump_seen)
+				goto unsupported;
+			source_actions++;
+			break;
+		case RTE_FLOW_ACTION_TYPE_SET_IPV6_DST:
+			if (jump_seen)
+				goto unsupported;
+			destination_actions++;
+			break;
+		case RTE_FLOW_ACTION_TYPE_COUNT:
+			count_actions++;
+			break;
+		case RTE_FLOW_ACTION_TYPE_JUMP:
+			jump = action->conf;
+			if (!jump || jump->group != 1)
+				goto unsupported;
+			jump_actions++;
+			jump_seen = true;
+			break;
+		default:
+			goto unsupported;
+		}
+	}
+	if (source_actions != 1 || destination_actions != 1 ||
+	    count_actions != 1 || jump_actions != 1)
+		goto unsupported;
+	source = &params->act_prop.act_details[BNXT_ULP_ACT_PROP_IDX_SET_IPV6_SRC];
+	destination = &params->act_prop.act_details[BNXT_ULP_ACT_PROP_IDX_SET_IPV6_DST];
+	if (ulp_bitmap_notzero(source, prefix_size) ||
+	    ulp_bitmap_notzero(destination, prefix_size) ||
+	    !ulp_bitmap_notzero(source + prefix_size, sizeof(rte_be32_t)) ||
+	    !ulp_bitmap_notzero(destination + prefix_size, sizeof(rte_be32_t)))
+		goto unsupported;
+	ULP_BITMAP_SET(params->act_bitmap.bits, BNXT_ULP_ACT_BIT_NAT64_CHAIN);
+	return BNXT_TF_RC_SUCCESS;
+
+unsupported:
+	BNXT_DRV_DBG(ERR, "NAT64 chain producer requires TCP/UDP in group 0, both "
+		     "zero-extended IPv4 address rewrites, one count, and jump "
+		     "group 1 after the rewrites\n");
+	return BNXT_TF_RC_PARSE_ERR;
+}
+
+static int32_t
+ulp_rte_nat64_l3_actions_check(const struct rte_flow_action *actions,
+			     struct ulp_rte_parser_params *params)
+{
+	uint64_t raw_bits = BNXT_ULP_ACT_BIT_NAT64_L3_DECAP |
+		BNXT_ULP_ACT_BIT_NAT64_L3_ENCAP;
+	struct rte_ipv6_addr expected_source = { 0 }, expected_destination = { 0 };
+	const struct rte_flow_item *item;
+	const struct rte_flow_item_ipv6 *ipv6_spec;
+	uint32_t count_actions = 0, port_actions = 0;
+	uint32_t source_actions = 0, destination_actions = 0;
+	bool decap_seen = false;
+
+	if (!(params->act_bitmap.bits & raw_bits))
+		return BNXT_TF_RC_SUCCESS;
+	if ((params->act_bitmap.bits & raw_bits) != raw_bits ||
+	    ULP_COMP_FLD_IDX_RD(params, BNXT_ULP_CF_IDX_DIRECTION) !=
+	    BNXT_ULP_DIR_INGRESS)
+		goto unsupported;
+	for (; actions->type != RTE_FLOW_ACTION_TYPE_END; actions++) {
+		switch (actions->type) {
+		case RTE_FLOW_ACTION_TYPE_RAW_DECAP:
+			decap_seen = true;
+			break;
+		case RTE_FLOW_ACTION_TYPE_RAW_ENCAP:
+		case RTE_FLOW_ACTION_TYPE_VOID:
+			break;
+		case RTE_FLOW_ACTION_TYPE_SET_IPV6_SRC:
+			if (decap_seen)
+				goto unsupported;
+			source_actions++;
+			break;
+		case RTE_FLOW_ACTION_TYPE_SET_IPV6_DST:
+			if (decap_seen)
+				goto unsupported;
+			destination_actions++;
+			break;
+		case RTE_FLOW_ACTION_TYPE_COUNT:
+			count_actions++;
+			break;
+		case RTE_FLOW_ACTION_TYPE_PORT_ID:
+			port_actions++;
+			break;
+		default:
+			goto unsupported;
+		}
+	}
+	if (count_actions != 1 || port_actions != 1 || source_actions > 1 ||
+	    source_actions != destination_actions ||
+	    ULP_COMP_FLD_IDX_RD(params, BNXT_ULP_CF_IDX_ACT_PORT_TYPE) !=
+	    BNXT_ULP_INTF_TYPE_VF_REP)
+		goto unsupported;
+	if (ULP_COMP_FLD_IDX_RD(params, BNXT_ULP_CF_IDX_GROUP_ID) == 1 &&
+	    (source_actions || ulp_rte_nat64_native_ingress_check(params)))
+		goto unsupported;
+	memcpy(&expected_source.a[RTE_IPV6_ADDR_SIZE - sizeof(rte_be32_t)],
+	       params->enc_field[BNXT_ULP_ENC_FIELD_IPV4_SADDR].spec,
+	       sizeof(rte_be32_t));
+	memcpy(&expected_destination.a[RTE_IPV6_ADDR_SIZE - sizeof(rte_be32_t)],
+	       params->enc_field[BNXT_ULP_ENC_FIELD_IPV4_DADDR].spec,
+	       sizeof(rte_be32_t));
+	if (source_actions) {
+		if (memcmp(&expected_source,
+			   &params->act_prop.act_details[BNXT_ULP_ACT_PROP_IDX_SET_IPV6_SRC],
+			   sizeof(expected_source)) ||
+		    memcmp(&expected_destination,
+			   &params->act_prop.act_details[BNXT_ULP_ACT_PROP_IDX_SET_IPV6_DST],
+			   sizeof(expected_destination)))
+			goto unsupported;
+	} else {
+		item = params->pattern;
+		while (item->type != RTE_FLOW_ITEM_TYPE_IPV6 &&
+		       item->type != RTE_FLOW_ITEM_TYPE_END)
+			item++;
+		if (item->type != RTE_FLOW_ITEM_TYPE_IPV6 || !item->spec)
+			goto unsupported;
+		ipv6_spec = item->spec;
+		if (!rte_ipv6_addr_eq(&expected_source, &ipv6_spec->hdr.src_addr) ||
+		    !rte_ipv6_addr_eq(&expected_destination, &ipv6_spec->hdr.dst_addr))
+			goto unsupported;
+	}
+	return BNXT_TF_RC_SUCCESS;
+
+unsupported:
+	BNXT_DRV_DBG(ERR, "NAT64 L3 proof requires RX raw header replacement, "
+		     "count, legacy port_id output, and zero-extended IPv4 addresses "
+		     "or matching IPv6 address rewrites before raw_decap\n");
+	return BNXT_TF_RC_PARSE_ERR;
+}
