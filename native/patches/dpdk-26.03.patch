+static bool
+bnxt_gre_rx_diag_enabled(void)
+{
+	const char *value = getenv("BNXT_GRE_RX_DIAG");
+
+	return value && strcmp(value, "1") == 0;
+}
+
+static int
+bnxt_gre_rx_diag_target_get(uint16_t *target_fid)
+{
+	const char *value = getenv("BNXT_GRE_DIAG_TARGET_FID");
+	unsigned long parsed;
+	char *end;
+	int base = 10;
+
+	if (!value)
+		return 0;
+	if (value[0] < '0' || value[0] > '9')
+		goto invalid;
+	if (value[0] == '0' && (value[1] == 'x' || value[1] == 'X'))
+		base = 16;
+	errno = 0;
+	parsed = strtoul(value, &end, base);
+	if (errno || end == value || *end || parsed > UINT16_MAX)
+		goto invalid;
+	if (parsed > 0xfff8) {
+		PMD_DRV_LOG_LINE(ERR,
+			"GRE_RX_DIAG BNXT_GRE_DIAG_TARGET_FID=%s is a reserved HWRM target",
+			value);
+		return -EINVAL;
+	}
+	*target_fid = (uint16_t)parsed;
+	return 1;
+
+invalid:
+	PMD_DRV_LOG_LINE(ERR,
+		"GRE_RX_DIAG invalid BNXT_GRE_DIAG_TARGET_FID=%s; "
+		"require an unsigned 16-bit decimal or hexadecimal function ID",
+		value);
+	return -EINVAL;
+}
+
+static int
+bnxt_hwrm_gre_rx_diag(struct bnxt *bp, uint16_t target_fid,
+		      uint8_t next_proto, uint8_t *status)
+{
+	struct hwrm_tunnel_dst_port_query_input req = {0};
+	struct hwrm_tunnel_dst_port_query_output *resp = bp->hwrm_cmd_resp_addr;
+	uint16_t response_length, firmware_error;
+	bool status_valid;
+	int rc;
+
+	HWRM_PREP(&req, HWRM_TUNNEL_DST_PORT_QUERY, BNXT_USE_CHIMP_MB);
+	req.target_id = rte_cpu_to_le_16(target_fid);
+	req.tunnel_type = HWRM_TUNNEL_DST_PORT_QUERY_INPUT_TUNNEL_TYPE_GRE;
+	req.tunnel_next_proto = next_proto;
+	rc = bnxt_hwrm_send_message(bp, &req, sizeof(req), BNXT_USE_CHIMP_MB);
+	response_length = rte_le_to_cpu_16(resp->resp_len);
+	firmware_error = rte_le_to_cpu_16(resp->error_code);
+	status_valid = !rc && !firmware_error && response_length >= sizeof(*resp) &&
+		rte_le_to_cpu_16(resp->req_type) == HWRM_TUNNEL_DST_PORT_QUERY &&
+		resp->seq_id == req.seq_id && resp->valid;
+	PMD_DRV_LOG_LINE(NOTICE,
+		"GRE_RX_DIAG query port=%u fid=%u target_fid=%u next_proto=%u "
+		"rc=%d fw_error=%#x resp_len=%u "
+		"resp_type=%#x seq=%u raw_status=%#x status_valid=%u",
+		bp->eth_dev->data->port_id, bp->fw_fid, target_fid, next_proto,
+		rc, firmware_error,
+		response_length, rte_le_to_cpu_16(resp->req_type),
+		rte_le_to_cpu_16(resp->seq_id), resp->status, status_valid);
+	if (status_valid) {
+		if (status)
+			*status = resp->status;
+		PMD_DRV_LOG_LINE(NOTICE,
+			"GRE_RX_DIAG enabled port=%u target_fid=%u next_proto=%u "
+			"chip=%u function=%u upar=%#x",
+			bp->eth_dev->data->port_id, target_fid, next_proto,
+			!!(resp->status & HWRM_TUNNEL_DST_PORT_QUERY_OUTPUT_STATUS_CHIP_LEVEL),
+			!!(resp->status & HWRM_TUNNEL_DST_PORT_QUERY_OUTPUT_STATUS_FUNC_LEVEL),
+			resp->upar_in_use);
+	}
+	HWRM_UNLOCK();
+	if (rc)
+		return rc;
+	if (firmware_error)
+		return firmware_error;
+	if (!status_valid)
+		return -EPROTO;
+	return 0;
+}
+
+static void
+bnxt_hwrm_gre_rx_diag_run(struct bnxt *bp, uint16_t target_fid,
+			  uint8_t next_proto)
+{
+	int rc = bnxt_hwrm_gre_rx_diag(bp, target_fid, next_proto, NULL);
+
+	if (rc) {
+		PMD_DRV_LOG_LINE(NOTICE,
+			"GRE_RX_DIAG query failed target_fid=%u next_proto=%u rc=%d",
+			target_fid, next_proto, rc);
+	}
+}
