+static int32_t
+ulp_rte_nat64_udp_actions_check(const struct rte_flow_action *actions,
+			      struct ulp_rte_parser_params *params)
+{
+	uint64_t raw_bits = BNXT_ULP_ACT_BIT_NAT64_UDP_DECAP |
+		BNXT_ULP_ACT_BIT_NAT64_UDP_ENCAP;
+	uint32_t count_actions = 0, port_actions = 0;
+
+	if (!(params->act_bitmap.bits & raw_bits))
+		return BNXT_TF_RC_SUCCESS;
+	if ((params->act_bitmap.bits & raw_bits) != raw_bits)
+		goto unsupported;
+	for (; actions->type != RTE_FLOW_ACTION_TYPE_END; actions++) {
+		switch (actions->type) {
+		case RTE_FLOW_ACTION_TYPE_RAW_DECAP:
+		case RTE_FLOW_ACTION_TYPE_RAW_ENCAP:
+		case RTE_FLOW_ACTION_TYPE_VOID:
+			break;
+		case RTE_FLOW_ACTION_TYPE_COUNT:
+			count_actions++;
+			break;
+		case RTE_FLOW_ACTION_TYPE_REPRESENTED_PORT:
+			port_actions++;
+			break;
+		default:
+			goto unsupported;
+		}
+	}
+	if (count_actions != 1 || port_actions != 1 ||
+	    ULP_COMP_FLD_IDX_RD(params, BNXT_ULP_CF_IDX_ACT_PORT_TYPE) !=
+	    BNXT_ULP_INTF_TYPE_VF_REP)
+		goto unsupported;
+	return BNXT_TF_RC_SUCCESS;
+
+unsupported:
+	BNXT_DRV_DBG(ERR, "NAT64 UDP proof requires raw_decap, raw_encap, "
+		     "count and represented_port\n");
+	return BNXT_TF_RC_PARSE_ERR;
+}
