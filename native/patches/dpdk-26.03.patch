+static int32_t
+ulp_rte_nat46_l3_encap_act_handler(const struct rte_flow_action *action_item,
+				 struct ulp_rte_parser_params *params)
+{
+	const struct rte_flow_action_raw_encap *raw = action_item->conf;
+	const struct rte_flow_item_ipv4 *matched_ipv4;
+	struct rte_flow_item_eth eth = { 0 };
+	struct rte_flow_item_ipv6 ipv6 = { 0 };
+	struct rte_ipv6_addr expected_source = { 0 }, expected_destination = { 0 };
+	uint8_t ttl;
+
+	if (!raw || !raw->data || raw->size != ULP_NAT46_L3_ENCAP_SIZE ||
+	    !ULP_BITMAP_ISSET(params->act_bitmap.bits,
+			      BNXT_ULP_ACT_BIT_NAT46_L3_DECAP) ||
+	    ULP_BITMAP_ISSET(params->act_bitmap.bits,
+			     BNXT_ULP_ACT_BIT_NAT46_L3_ENCAP))
+		goto unsupported;
+	if (raw->preserve && ulp_bitmap_notzero(raw->preserve, raw->size))
+		goto unsupported;
+	memcpy(&eth.hdr, raw->data, sizeof(eth.hdr));
+	memcpy(&ipv6.hdr, raw->data + sizeof(eth.hdr), sizeof(ipv6.hdr));
+	ttl = ULP_COMP_FLD_IDX_RD(params, BNXT_ULP_CF_IDX_O_L3_TTL);
+	if (eth.hdr.ether_type != RTE_BE16(RTE_ETHER_TYPE_IPV6) ||
+	    (rte_be_to_cpu_32(ipv6.hdr.vtc_flow) >> 28) != 6 ||
+	    ipv6.hdr.payload_len || ipv6.hdr.hop_limits != ttl - 1 ||
+	    ulp_rte_nat46_pattern_check(params, ipv6.hdr.proto))
+		goto unsupported;
