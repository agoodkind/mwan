 	return ret;
 }
 
+
+static double
+counter_poc_seconds(clockid_t clock_id)
+{
+	struct timespec value;
+
+	if (clock_gettime(clock_id, &value) != 0)
+		rte_exit(EXIT_FAILURE, "Counter benchmark clock failed\n");
+	return value.tv_sec + value.tv_nsec / 1000000000.0;
+}
+
+static int
+counter_poc_sweep(portid_t port_id)
+{
+	struct counter_sample {
+		struct port_flow *flow;
+		uint64_t hits;
+		bool valid;
+	};
+	struct counter_sample *samples;
+	struct port_flow *flow;
+	struct rte_flow_action action = {.type = RTE_FLOW_ACTION_TYPE_COUNT};
+	struct rte_flow_error error;
+	size_t count = 0, index;
+	unsigned int sweep;
+	uint64_t failures = 0, unavailable = 0, backwards = 0;
+	double wall_start, cpu_start, thread_start, query_seconds = 0;
+	double wall_end, cpu_end, thread_end;
+
+	for (flow = ports[port_id].flow_list; flow; flow = flow->next)
+		count++;
+	if (!count)
+		return -ENOENT;
+	samples = calloc(count, sizeof(*samples));
+	if (!samples)
+		return -ENOMEM;
+	index = 0;
+	for (flow = ports[port_id].flow_list; flow; flow = flow->next)
+		samples[index++].flow = flow;
+	wall_start = counter_poc_seconds(CLOCK_MONOTONIC);
+	cpu_start = counter_poc_seconds(CLOCK_PROCESS_CPUTIME_ID);
+	thread_start = counter_poc_seconds(CLOCK_THREAD_CPUTIME_ID);
+	for (sweep = 0; sweep < 8; sweep++) {
+		uint64_t changed = 0, hits = 0;
+		double start = counter_poc_seconds(CLOCK_MONOTONIC);
+
+		for (index = 0; index < count; index++) {
+			struct rte_flow_query_count query = {0};
+			int result;
+
+			memset(&error, 0, sizeof(error));
+			result = rte_flow_query(port_id, samples[index].flow->flow,
+						&action, &query, &error);
+			if (result) {
+				failures++;
+				continue;
+			}
+			if (!query.hits_set || !query.bytes_set) {
+				unavailable++;
+				continue;
+			}
+			if (samples[index].valid && query.hits < samples[index].hits)
+				backwards++;
+			if (samples[index].valid && query.hits > samples[index].hits)
+				changed++;
+			samples[index].hits = query.hits;
+			samples[index].valid = true;
+			hits += query.hits;
+		}
+		query_seconds += counter_poc_seconds(CLOCK_MONOTONIC) - start;
+		printf("COUNTER_POC sweep=%u rules=%zu changed=%"PRIu64
+		       " hits=%"PRIu64" failures=%"PRIu64
+		       " unavailable=%"PRIu64" backwards=%"PRIu64"\n",
+		       sweep, count, changed, hits, failures, unavailable, backwards);
+		if (sweep != 7)
+			sleep(1);
+	}
+	wall_end = counter_poc_seconds(CLOCK_MONOTONIC);
+	cpu_end = counter_poc_seconds(CLOCK_PROCESS_CPUTIME_ID);
+	thread_end = counter_poc_seconds(CLOCK_THREAD_CPUTIME_ID);
+	printf("COUNTER_POC summary rules=%zu queries=%zu wall_s=%.9f"
+	       " query_wall_s=%.9f process_cpu_s=%.9f thread_cpu_s=%.9f"
+	       " process_core_pct=%.6f thread_core_pct=%.6f\n",
+	       count, count * 8, wall_end - wall_start, query_seconds,
+	       cpu_end - cpu_start, thread_end - thread_start,
+	       100 * (cpu_end - cpu_start) / (wall_end - wall_start),
+	       100 * (thread_end - thread_start) / (wall_end - wall_start));
+	for (index = 0; index < count; index++) {
+		if (samples[index].hits)
+			printf("COUNTER_POC active_rule=%"PRIu64" hits=%"PRIu64"\n",
+			       samples[index].flow->id, samples[index].hits);
+	}
+	free(samples);
+	return failures || unavailable || backwards ? -EIO : 0;
+}
