+	    vfr->ilt_session_fid || vfr->ilt_started ||
+	    vfr->ilt_native_release_pending)
+		return -EBUSY;
+	rc = bnxt_ulp_native_miss_rep_busy(vfr, true);
+	if (rc)
+		return rc;
+	vfr->role = role;
+	return 0;
+}
 
