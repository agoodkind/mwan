+static int bnxt_tf_vfr_flush_flows(struct bnxt_representor *vfr_bp);
+
+static bool
+bnxt_rep_ilt_active(struct bnxt_representor *vfr)
+{
+	return vfr->vf_rx_ilt.valid || vfr->vf_tx_ilt.valid ||
+		vfr->ilt_shared_user || vfr->ilt_default_rules ||
+		vfr->ilt_cfa_pair || vfr->ilt_session_fid || vfr->ilt_started ||
+		vfr->ilt_native_release_pending;
+}
+
+static void
+bnxt_rep_ilt_log(const char *stage, enum tf_dir direction,
+		 const struct bnxt_rep_ilt_entry *entry)
+{
+	const uint8_t *data = entry->data;
+
+	if (!getenv("BNXT_REP_ILT_DIAG"))
+		return;
+	PMD_DRV_LOG_LINE(NOTICE,
+		"ILT_DIAG stage=%s dir=%u index=%u "
+		"bytes=%02x%02x%02x%02x%02x%02x%02x%02x",
+		stage, direction, entry->index,
+		data[0], data[1], data[2], data[3],
+		data[4], data[5], data[6], data[7]);
+}
+
+static int
+bnxt_rep_ilt_read(struct tf *tfp, enum tf_dir direction, uint32_t index,
+		  struct bnxt_rep_ilt_entry *entry)
+{
+	struct tf_get_if_tbl_entry_parms params = { 0 };
+	int rc;
+
+	params.dir = direction;
+	params.type = TF_IF_TBL_TYPE_ILT;
+	params.idx = index;
+	params.data = entry->data;
+	params.data_sz_in_bytes = sizeof(entry->data);
+	rc = tf_get_if_tbl_entry(tfp, &params);
+	if (rc)
+		return rc;
+	entry->index = index;
+	entry->valid = true;
+	return 0;
+}
+
+static int
+bnxt_rep_ilt_restore(struct tf *tfp, enum tf_dir direction,
+		     struct bnxt_rep_ilt_entry *entry)
+{
+	struct tf_set_if_tbl_entry_parms params = { 0 };
+	struct bnxt_rep_ilt_entry actual = { 0 };
+	int rc;
+
+	if (!entry->valid)
+		return 0;
+	if (getenv("BNXT_REP_ILT_DIAG")) {
+		rc = bnxt_rep_ilt_read(tfp, direction, entry->index, &actual);
+		if (rc)
+			PMD_DRV_LOG_LINE(NOTICE,
+				"ILT_DIAG stage=after-default-delete-pair-free "
+				"dir=%u index=%u rc=%d",
+				direction, entry->index, rc);
+		else
+			bnxt_rep_ilt_log("after-default-delete-pair-free", direction,
+					 &actual);
+	}
+	params.dir = direction;
+	params.type = TF_IF_TBL_TYPE_ILT;
+	params.idx = entry->index;
+	params.data = entry->data;
+	params.data_sz_in_bytes = sizeof(entry->data);
+	rc = tf_set_if_tbl_entry(tfp, &params);
+	if (rc)
+		return rc;
+	rc = bnxt_rep_ilt_read(tfp, direction, entry->index, &actual);
+	if (rc)
+		return rc;
+	if (memcmp(actual.data, entry->data, sizeof(entry->data))) {
+		PMD_DRV_LOG_LINE(ERR, "ILT restore readback differs dir=%u index=%u",
+				 direction, entry->index);
+		return -EIO;
+	}
+	bnxt_rep_ilt_log("restore-readback", direction, &actual);
+	entry->valid = false;
+	return 0;
+}
+
+/* The parent lock serializes shared snapshots and default-rule updates. */
+static int
+bnxt_rep_ilt_save(struct bnxt_representor *vfr)
+{
+	struct bnxt *bp = vfr->parent_dev->data->dev_private;
+	struct bnxt_rep_ilt_entry vf_rx = { 0 }, vf_tx = { 0 }, drv_tx = { 0 };
+	uint16_t vf_svif, drv_svif;
+	uint32_t ifindex;
+	struct tf *tfp;
+	int rc;
+
+	if (bnxt_rep_ilt_active(vfr))
+		return -EBUSY;
+	tfp = bnxt_ulp_cntxt_tfp_get(bp->ulp_ctx, BNXT_ULP_SESSION_TYPE_DEFAULT);
+	if (!tfp)
+		return -EINVAL;
+	rc = ulp_port_db_dev_port_to_ulp_index(bp->ulp_ctx, vfr->dpdk_port_id,
+					     &ifindex);
+	if (rc)
+		return rc;
+	rc = ulp_port_db_svif_get(bp->ulp_ctx, ifindex, BNXT_ULP_VF_FUNC_SVIF,
+				 &vf_svif);
+	if (rc)
+		return rc;
+	rc = ulp_port_db_svif_get(bp->ulp_ctx, ifindex, BNXT_ULP_DRV_FUNC_SVIF,
+				 &drv_svif);
+	if (rc)
+		return rc;
+	if (bp->rep_tx_ilt_users &&
+	    (!bp->rep_tx_ilt.valid || bp->rep_tx_ilt.index != drv_svif))
+		return -EINVAL;
+	if (bp->rep_tx_ilt_users == UINT16_MAX)
+		return -EOVERFLOW;
+	rc = bnxt_rep_ilt_read(tfp, TF_DIR_RX, vf_svif, &vf_rx);
+	if (rc)
+		return rc;
+	if (vf_svif != drv_svif) {
+		rc = bnxt_rep_ilt_read(tfp, TF_DIR_TX, vf_svif, &vf_tx);
+		if (rc)
+			return rc;
+	}
+	if (!bp->rep_tx_ilt_users) {
+		rc = bnxt_rep_ilt_read(tfp, TF_DIR_TX, drv_svif, &drv_tx);
+		if (rc)
+			return rc;
+		bp->rep_tx_ilt = drv_tx;
+		bnxt_rep_ilt_log("snapshot-controller", TF_DIR_TX, &drv_tx);
+	}
+	vfr->vf_rx_ilt = vf_rx;
+	vfr->vf_tx_ilt = vf_tx;
+	bnxt_rep_ilt_log("snapshot-vf", TF_DIR_RX, &vf_rx);
+	if (vf_tx.valid)
+		bnxt_rep_ilt_log("snapshot-vf", TF_DIR_TX, &vf_tx);
+	vfr->ilt_shared_user = true;
+	bp->rep_tx_ilt_users++;
+	return 0;
+}
+
+static int
+bnxt_rep_ilt_rules_free(struct bnxt_representor *vfr)
+{
+	struct bnxt *bp = vfr->parent_dev->data->dev_private;
+	struct bnxt_ulp_vfr_rule_info *info;
+	int rc;
+
+	if (!vfr->ilt_default_rules)
+		return 0;
+	info = bnxt_ulp_cntxt_ptr2_ulp_vfr_info_get(bp->ulp_ctx,
+						vfr->dpdk_port_id);
+	if (!info || !info->valid)
+		return -EINVAL;
+	rc = ulp_default_flow_destroy(bp->eth_dev, info->vfr_flow_id);
+	if (rc)
+		return rc;
+	vfr->vfr_tx_cfa_action = 0;
+	memset(info, 0, sizeof(*info));
+	vfr->ilt_default_rules = false;
+	return 0;
+}
+
+static int
+bnxt_rep_native_release_notify(struct bnxt_representor *vfr)
+{
+	struct bnxt *bp = vfr->parent_dev->data->dev_private;
+	struct hwrm_fwd_async_event_cmpl_input req = { 0 };
+	struct hwrm_fwd_async_event_cmpl_output resp = { 0 };
+	struct hwrm_async_event_cmpl event = { 0 };
+	int rc;
+
+	if (!BNXT_CHIP_P5(bp) || BNXT_REP_PF(vfr) ||
+	    vfr->fw_fid == bp->fw_fid || vfr->fw_fid == UINT16_MAX)
+		return -EINVAL;
+
+	req.encap_async_event_target_id = rte_cpu_to_le_16(vfr->fw_fid);
+	event.type = rte_cpu_to_le_16(HWRM_ASYNC_EVENT_CMPL_TYPE_HWRM_ASYNC_EVENT);
+	event.event_id = rte_cpu_to_le_16(HWRM_ASYNC_EVENT_CMPL_EVENT_ID_VF_CFG_CHANGE);
+	event.event_data1 = rte_cpu_to_le_32(
+		HWRM_ASYNC_EVENT_CMPL_VF_CFG_CHANGE_EVENT_DATA1_TF_OWNERSHIP_RELEASE);
+	memcpy(req.encap_async_event_cmpl, &event, sizeof(event));
+	PMD_DRV_LOG_LINE(NOTICE,
+		"NATIVE_RELEASE_NOTIFY controller_fid=%u target_fid=%u request",
+		bp->fw_fid, vfr->fw_fid);
+	/* The mailbox helper logs raw firmware errors before unlocking. */
+	rc = bnxt_hwrm_tf_message_direct(bp, false, HWRM_FWD_ASYNC_EVENT_CMPL,
+					&req, sizeof(req), &resp, sizeof(resp));
+	if (rc) {
+		PMD_DRV_LOG_LINE(ERR,
+			"NATIVE_RELEASE_NOTIFY controller_fid=%u target_fid=%u rc=%d",
+			bp->fw_fid, vfr->fw_fid, rc);
+		return rc;
+	}
+	if (rte_le_to_cpu_16(resp.resp_len) != sizeof(resp) ||
+	    rte_le_to_cpu_16(resp.req_type) != HWRM_FWD_ASYNC_EVENT_CMPL ||
+	    resp.valid != HWRM_RESP_VALID_KEY) {
+		PMD_DRV_LOG_LINE(ERR,
+			"NATIVE_RELEASE_NOTIFY target_fid=%u invalid response "
+			"fw_error=%u resp_len=%u req_type=%u valid=%u",
+			vfr->fw_fid, rte_le_to_cpu_16(resp.error_code),
+			rte_le_to_cpu_16(resp.resp_len), rte_le_to_cpu_16(resp.req_type),
+			resp.valid);
+		return -EIO;
+	}
+	PMD_DRV_LOG_LINE(NOTICE,
+		"NATIVE_RELEASE_NOTIFY controller_fid=%u target_fid=%u "
+		"rc=0 fw_error=%u resp_len=%u",
+		bp->fw_fid, vfr->fw_fid, rte_le_to_cpu_16(resp.error_code),
+		rte_le_to_cpu_16(resp.resp_len));
+	return 0;
+}
+
+/* Free the pair before defaults, then restore before session removal. */
+static int
+bnxt_rep_ilt_free(struct bnxt_representor *vfr)
+{
+	struct bnxt *bp = vfr->parent_dev->data->dev_private;
+	const char *notify = getenv("BNXT_REP_NATIVE_RELEASE_NOTIFY");
+	struct tf *tfp;
+	int rc;
+
+	if (!bnxt_rep_ilt_active(vfr))
+		return 0;
+	vfr->ilt_started = false;
+	tfp = bnxt_ulp_cntxt_tfp_get(bp->ulp_ctx, BNXT_ULP_SESSION_TYPE_DEFAULT);
+	if (!tfp)
+		return -EINVAL;
+	rc = bnxt_tf_vfr_flush_flows(vfr);
+	if (rc)
+		return rc;
+	if (vfr->ilt_cfa_pair) {
+		rc = bnxt_hwrm_cfa_pair_free(bp, vfr);
+		if (rc)
+			return rc;
