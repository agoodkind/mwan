+	if (!raw || !raw->data || raw->size != ULP_NAT46_L3_DECAP_SIZE ||
+	    ULP_BITMAP_ISSET(params->act_bitmap.bits,
+			     BNXT_ULP_ACT_BIT_NAT46_L3_DECAP))
+		goto unsupported;
+	memcpy(&eth, raw->data, sizeof(eth));
+	memcpy(&ipv4, raw->data + sizeof(eth), sizeof(ipv4));
+	if (eth.ether_type != RTE_BE16(RTE_ETHER_TYPE_IPV4) ||
+	    ipv4.version_ihl != RTE_IPV4_VHL_DEF ||
+	    ipv4.fragment_offset ||
+	    ulp_rte_nat46_pattern_check(params, ipv4.next_proto_id))
+		goto unsupported;
+	ULP_BITMAP_SET(params->act_bitmap.bits,
+		       BNXT_ULP_ACT_BIT_NAT46_L3_DECAP);
