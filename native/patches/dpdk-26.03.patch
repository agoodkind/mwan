+static int32_t
+ulp_rte_nat64_pattern_check(struct ulp_rte_parser_params *params,
+			    uint8_t protocol, bool allow_group_one)
+{
+	const struct rte_flow_item *item = params->pattern;
+	const struct rte_flow_item_ipv6 *ipv6_spec, *ipv6_mask;
+	const struct rte_flow_item_udp *udp_spec, *udp_mask;
+	const struct rte_flow_item_tcp *tcp_spec, *tcp_mask;
+	const struct rte_flow_item_eth *eth_mask;
+	const struct rte_flow_item_port_id *port_spec, *port_mask;
+	enum bnxt_ulp_intf_type match_port_type;
+	enum rte_flow_item_type transport;
+	rte_be16_t source_port, destination_port, source_mask, destination_mask;
+	uint32_t dev_id;
+
+	if (protocol == IPPROTO_UDP)
+		transport = RTE_FLOW_ITEM_TYPE_UDP;
+	else if (protocol == IPPROTO_TCP)
+		transport = RTE_FLOW_ITEM_TYPE_TCP;
+	else
+		goto unsupported;
+	match_port_type = ULP_COMP_FLD_IDX_RD(params,
+					  BNXT_ULP_CF_IDX_MATCH_PORT_TYPE);
+	if (bnxt_ulp_cntxt_dev_id_get(params->ulp_ctx, &dev_id) ||
+	    dev_id != BNXT_ULP_DEVICE_ID_THOR ||
+	    !(params->dir_attr & (BNXT_ULP_FLOW_ATTR_INGRESS |
+				 BNXT_ULP_FLOW_ATTR_TRANSFER)) ||
+	    (params->dir_attr & BNXT_ULP_FLOW_ATTR_EGRESS) || params->app_id)
+		goto unsupported;
+	if (ULP_COMP_FLD_IDX_RD(params, BNXT_ULP_CF_IDX_GROUP_ID) &&
+	    (!allow_group_one ||
+	     ULP_COMP_FLD_IDX_RD(params, BNXT_ULP_CF_IDX_GROUP_ID) != 1))
+		goto unsupported;
+	if (!item)
+		goto unsupported;
+	if (item->type == RTE_FLOW_ITEM_TYPE_PORT_ID) {
+		if (item->last || !item->spec || !item->mask)
+			goto unsupported;
+		port_spec = item->spec;
+		port_mask = item->mask;
+		if (port_mask->id != UINT32_MAX ||
+		    port_spec->id != ULP_COMP_FLD_IDX_RD(params,
+						BNXT_ULP_CF_IDX_INCOMING_IF))
+			goto unsupported;
+		item++;
+	}
+	if (item->type == RTE_FLOW_ITEM_TYPE_REPRESENTED_PORT) {
+		if (item->last ||
+		    !(params->dir_attr & BNXT_ULP_FLOW_ATTR_TRANSFER) ||
+		    ULP_COMP_FLD_IDX_RD(params, BNXT_ULP_CF_IDX_MATCH_PORT_TYPE) !=
+		    BNXT_ULP_INTF_TYPE_VF_REP)
+			goto unsupported;
+		item++;
+	} else {
+		if (item->type != RTE_FLOW_ITEM_TYPE_ETH ||
+		    (match_port_type != BNXT_ULP_INTF_TYPE_PF &&
+		     match_port_type != BNXT_ULP_INTF_TYPE_TRUSTED_VF) ||
+		    !item->spec || !item->mask)
+			goto unsupported;
+		eth_mask = item->mask;
+		if (!rte_is_same_ether_addr(&eth_mask->hdr.dst_addr,
+					  &rte_flow_item_eth_mask.hdr.dst_addr))
+			goto unsupported;
+	}
+	if (item->type != RTE_FLOW_ITEM_TYPE_ETH || item->last)
+		goto unsupported;
+	item++;
+	if (item->type != RTE_FLOW_ITEM_TYPE_IPV6 || item->last ||
+	    !item->spec || !item->mask)
+		goto unsupported;
+	ipv6_spec = item->spec;
+	ipv6_mask = item->mask;
+	if (!rte_ipv6_addr_eq(&ipv6_mask->hdr.src_addr,
+			      &rte_flow_item_ipv6_mask.hdr.src_addr) ||
+	    !rte_ipv6_addr_eq(&ipv6_mask->hdr.dst_addr,
+			      &rte_flow_item_ipv6_mask.hdr.dst_addr) ||
+	    ipv6_mask->hdr.proto != UINT8_MAX ||
+	    ipv6_spec->hdr.proto != protocol ||
+	    ipv6_mask->hdr.hop_limits != UINT8_MAX ||
+	    ipv6_spec->hdr.hop_limits <= 1)
+		goto unsupported;
+	item++;
+	if (item->type != transport || item->last ||
+	    !item->spec || !item->mask)
+		goto unsupported;
+	if (protocol == IPPROTO_UDP) {
+		udp_spec = item->spec;
+		udp_mask = item->mask;
+		source_port = udp_spec->hdr.src_port;
+		destination_port = udp_spec->hdr.dst_port;
+		source_mask = udp_mask->hdr.src_port;
+		destination_mask = udp_mask->hdr.dst_port;
+	} else {
+		tcp_spec = item->spec;
+		tcp_mask = item->mask;
+		source_port = tcp_spec->hdr.src_port;
+		destination_port = tcp_spec->hdr.dst_port;
+		source_mask = tcp_mask->hdr.src_port;
+		destination_mask = tcp_mask->hdr.dst_port;
+	}
+	if (source_mask != RTE_BE16(UINT16_MAX) ||
+	    destination_mask != RTE_BE16(UINT16_MAX) ||
+	    !source_port || !destination_port)
+		goto unsupported;
+	item++;
+	if (item->type != RTE_FLOW_ITEM_TYPE_END ||
+	    ULP_BITMAP_ISSET(params->cf_bitmap, BNXT_ULP_CF_BIT_IS_TUNNEL))
+		goto unsupported;
+	return BNXT_TF_RC_SUCCESS;
+
+unsupported:
+	BNXT_DRV_DBG(ERR, "NAT64 proof requires Thor ingress, an exact "
+		     "IPv6/TCP or IPv6/UDP flow and fixed hop limit in an allowed group\n");
+	return BNXT_TF_RC_PARSE_ERR;
+}
+
+static int32_t
+ulp_rte_nat64_chain_ingress_mac_check(struct ulp_rte_parser_params *params,
+				    const struct rte_ether_addr *destination)
+{
+	const struct rte_flow_item *item = params->pattern;
+	const struct rte_flow_item_port_id *port_spec, *port_mask;
+	const struct rte_flow_item_eth *eth_spec, *eth_mask;
+
+	if (ULP_COMP_FLD_IDX_RD(params, BNXT_ULP_CF_IDX_DIRECTION) !=
+	    BNXT_ULP_DIR_INGRESS ||
+	    ULP_COMP_FLD_IDX_RD(params, BNXT_ULP_CF_IDX_MATCH_PORT_TYPE) !=
+	    BNXT_ULP_INTF_TYPE_TRUSTED_VF ||
+	    ULP_COMP_FLD_IDX_RD(params, BNXT_ULP_CF_IDX_INCOMING_IF) != 0 ||
+	    !(params->dir_attr & BNXT_ULP_FLOW_ATTR_TRANSFER))
+		goto unsupported;
+	if (!item || item->type != RTE_FLOW_ITEM_TYPE_PORT_ID ||
+	    item->last || !item->spec || !item->mask)
+		goto unsupported;
+	port_spec = item->spec;
+	port_mask = item->mask;
+	if (port_spec->id != 0 || port_mask->id != UINT32_MAX)
+		goto unsupported;
+	item++;
+	if (item->type != RTE_FLOW_ITEM_TYPE_ETH || item->last ||
+	    !item->spec || !item->mask)
+		goto unsupported;
+	eth_spec = item->spec;
+	eth_mask = item->mask;
+	if (!rte_is_same_ether_addr(&eth_spec->hdr.dst_addr, destination) ||
+	    !rte_is_same_ether_addr(&eth_mask->hdr.dst_addr,
+				  &rte_flow_item_eth_mask.hdr.dst_addr))
+		goto unsupported;
+	return BNXT_TF_RC_SUCCESS;
+
+unsupported:
+	BNXT_DRV_DBG(ERR, "NAT64 chain requires trusted controller port 0, "
+		     "an exact port_id source, transfer, and the expected destination MAC\n");
+	return BNXT_TF_RC_PARSE_ERR;
+}
+
+static int32_t
+ulp_rte_nat64_chain_ingress_check(struct ulp_rte_parser_params *params)
+{
+	static const struct rte_ether_addr test_mac = {
+		.addr_bytes = { 0x02, 0x57, 0x50, 0x04, 0x77, 0x02 }
+	};
+
+	return ulp_rte_nat64_chain_ingress_mac_check(params, &test_mac);
+}
+
+static int32_t
+ulp_rte_nat64_native_ingress_check(struct ulp_rte_parser_params *params)
+{
+	struct rte_ether_addr destination;
+	int32_t rc;
+
+	rc = bnxt_pmd_get_represented_mac(0, 1, &destination);
+	if (rc) {
+		BNXT_DRV_DBG(ERR, "NAT64 cannot query represented VF MAC: %d\n", rc);
+		return BNXT_TF_RC_PARSE_ERR;
+	}
+	return ulp_rte_nat64_chain_ingress_mac_check(params, &destination);
+}
+
+static int32_t
+ulp_rte_nat46_pattern_check(struct ulp_rte_parser_params *params,
+			  uint8_t protocol)
+{
+	const struct rte_flow_item *item;
+	const struct rte_flow_item_ipv4 *ipv4_spec, *ipv4_mask;
+	const struct rte_flow_item_udp *udp_spec, *udp_mask;
+	const struct rte_flow_item_tcp *tcp_spec, *tcp_mask;
+	rte_be16_t source_port, destination_port, source_mask, destination_mask;
+	enum rte_flow_item_type transport;
+	uint32_t dev_id;
+
+	if (protocol == IPPROTO_UDP)
+		transport = RTE_FLOW_ITEM_TYPE_UDP;
+	else if (protocol == IPPROTO_TCP)
+		transport = RTE_FLOW_ITEM_TYPE_TCP;
+	else
+		goto unsupported;
+	if (bnxt_ulp_cntxt_dev_id_get(params->ulp_ctx, &dev_id) ||
+	    dev_id != BNXT_ULP_DEVICE_ID_THOR || params->app_id ||
+	    ULP_COMP_FLD_IDX_RD(params, BNXT_ULP_CF_IDX_GROUP_ID) ||
+	    (params->dir_attr & BNXT_ULP_FLOW_ATTR_EGRESS) ||
+	    ulp_rte_nat64_chain_ingress_check(params))
+		goto unsupported;
+	item = params->pattern + 2;
+	if (item->type != RTE_FLOW_ITEM_TYPE_IPV4 || item->last ||
+	    !item->spec || !item->mask)
+		goto unsupported;
+	ipv4_spec = item->spec;
+	ipv4_mask = item->mask;
+	if (ipv4_mask->hdr.src_addr != RTE_BE32(UINT32_MAX) ||
+	    ipv4_mask->hdr.dst_addr != RTE_BE32(UINT32_MAX) ||
+	    ipv4_mask->hdr.version_ihl || ipv4_mask->hdr.fragment_offset ||
+	    !ipv4_spec->hdr.src_addr || !ipv4_spec->hdr.dst_addr ||
+	    ipv4_mask->hdr.next_proto_id != UINT8_MAX ||
+	    ipv4_spec->hdr.next_proto_id != protocol ||
+	    ipv4_mask->hdr.time_to_live != UINT8_MAX ||
+	    ipv4_spec->hdr.time_to_live <= 1 ||
+	    (ipv4_spec->hdr.version_ihl &&
+	     ipv4_spec->hdr.version_ihl != RTE_IPV4_VHL_DEF) ||
+	    (ipv4_spec->hdr.fragment_offset & ~RTE_BE16(RTE_IPV4_HDR_DF_FLAG)))
+		goto unsupported;
+	item++;
+	if (item->type != transport || item->last || !item->spec || !item->mask)
+		goto unsupported;
+	if (protocol == IPPROTO_UDP) {
+		udp_spec = item->spec;
+		udp_mask = item->mask;
+		if (udp_mask->hdr.dgram_len || udp_mask->hdr.dgram_cksum)
+			goto unsupported;
+		source_port = udp_spec->hdr.src_port;
+		destination_port = udp_spec->hdr.dst_port;
+		source_mask = udp_mask->hdr.src_port;
+		destination_mask = udp_mask->hdr.dst_port;
+	} else {
+		tcp_spec = item->spec;
+		tcp_mask = item->mask;
+		source_port = tcp_spec->hdr.src_port;
+		destination_port = tcp_spec->hdr.dst_port;
+		source_mask = tcp_mask->hdr.src_port;
+		destination_mask = tcp_mask->hdr.dst_port;
+	}
+	if (source_mask != RTE_BE16(UINT16_MAX) ||
+	    destination_mask != RTE_BE16(UINT16_MAX) ||
+	    !source_port || !destination_port)
+		goto unsupported;
+	item++;
+	if (item->type != RTE_FLOW_ITEM_TYPE_END ||
+	    ULP_BITMAP_ISSET(params->cf_bitmap, BNXT_ULP_CF_BIT_IS_TUNNEL))
+		goto unsupported;
+	return BNXT_TF_RC_SUCCESS;
+
+unsupported:
+	BNXT_DRV_DBG(ERR, "NAT64 reverse proof requires group 0, trusted RX "
+		     "controller 0, the dedicated MAC, and exact IPv4 TCP/UDP "
+		     "addresses, ports, protocol and TTL\n");
+	return BNXT_TF_RC_PARSE_ERR;
+}
+
+static int32_t
+ulp_rte_nat46_l3_actions_check(const struct rte_flow_action *actions,
+			     struct ulp_rte_parser_params *params)
+{
+	uint64_t raw_bits = BNXT_ULP_ACT_BIT_NAT46_L3_DECAP |
+		BNXT_ULP_ACT_BIT_NAT46_L3_ENCAP;
+	const struct rte_flow_action_port_id *port;
+	uint32_t count_actions = 0, port_actions = 0;
+
+	if (!(params->act_bitmap.bits & raw_bits))
+		return BNXT_TF_RC_SUCCESS;
+	if ((params->act_bitmap.bits & raw_bits) != raw_bits)
+		goto unsupported;
+	for (; actions->type != RTE_FLOW_ACTION_TYPE_END; actions++) {
+		switch (actions->type) {
+		case RTE_FLOW_ACTION_TYPE_RAW_DECAP:
+		case RTE_FLOW_ACTION_TYPE_RAW_ENCAP:
+		case RTE_FLOW_ACTION_TYPE_VOID:
+			break;
+		case RTE_FLOW_ACTION_TYPE_COUNT:
+			count_actions++;
+			break;
+		case RTE_FLOW_ACTION_TYPE_PORT_ID:
+			port = actions->conf;
+			if (!port || port->original || port->id != 1)
+				goto unsupported;
+			port_actions++;
+			break;
+		default:
+			goto unsupported;
+		}
+	}
+	if (count_actions != 1 || port_actions != 1 ||
+	    ULP_COMP_FLD_IDX_RD(params, BNXT_ULP_CF_IDX_ACT_PORT_TYPE) !=
+	    BNXT_ULP_INTF_TYPE_VF_REP)
+		goto unsupported;
+	return BNXT_TF_RC_SUCCESS;
+
+unsupported:
+	BNXT_DRV_DBG(ERR, "NAT64 reverse proof requires raw_decap, raw_encap, "
+		     "one count and legacy port_id 1 without other actions\n");
+	return BNXT_TF_RC_PARSE_ERR;
+}
