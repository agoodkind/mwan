+int32_t
+ulp_rte_nat64_udp_decap_act_handler(const struct rte_flow_action *action_item,
+				  struct ulp_rte_parser_params *params)
+{
+	const struct rte_flow_action_raw_decap *raw = action_item->conf;
+	struct rte_ether_hdr eth;
+	struct rte_ipv6_hdr ipv6;
+
+	if (ulp_rte_nat64_pattern_check(params, IPPROTO_UDP, false))
+		return BNXT_TF_RC_PARSE_ERR;
+	if (!raw || !raw->data || raw->size != ULP_NAT64_UDP_DECAP_SIZE ||
+	    ULP_BITMAP_ISSET(params->act_bitmap.bits,
+			     BNXT_ULP_ACT_BIT_NAT64_UDP_DECAP))
+		goto unsupported;
+	memcpy(&eth, raw->data, sizeof(eth));
+	memcpy(&ipv6, raw->data + sizeof(eth), sizeof(ipv6));
+	if (eth.ether_type != RTE_BE16(RTE_ETHER_TYPE_IPV6) ||
+	    (rte_be_to_cpu_32(ipv6.vtc_flow) >> 28) != 6 ||
+	    ipv6.proto != IPPROTO_UDP)
+		goto unsupported;
+	ULP_BITMAP_SET(params->act_bitmap.bits,
+		       BNXT_ULP_ACT_BIT_NAT64_UDP_DECAP);
+	return BNXT_TF_RC_SUCCESS;
+
+unsupported:
+	BNXT_DRV_DBG(ERR, "NAT64 UDP raw_decap requires one Ethernet/IPv6/UDP header\n");
+	return BNXT_TF_RC_PARSE_ERR;
+}
