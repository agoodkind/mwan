+int32_t
+bnxt_ulp_grp_miss_act_set(struct rte_eth_dev *dev,
+			const struct rte_flow_attr *attr,
+			const struct rte_flow_action actions[], uint32_t *flow_id)
+{
+	struct bnxt_ulp_context *ctx = bnxt_ulp_eth_dev_ptr2_cntxt_get(dev);
+	int rc;
+
+	if (!ctx || bnxt_ulp_cntxt_acquire_fdb_lock(ctx))
+		return -EINVAL;
+	rc = bnxt_ulp_grp_miss_act_set_locked(dev, attr, actions, flow_id);
+	bnxt_ulp_cntxt_release_fdb_lock(ctx);
+	return rc;
+}
+
+/* The single-controller proof drains every regular rule before removal. */
+static bool
+bnxt_ulp_native_miss_has_dependents(struct bnxt_ulp_context *ctx)
+{
+	struct bnxt_ulp_flow_tbl *table = &ctx->cfg_data->flow_db->flow_tbl;
+	uint32_t index;
+
+	for (index = 0; index < (table->num_flows + ULP_INDEX_BITMAP_SIZE - 1) /
+	     ULP_INDEX_BITMAP_SIZE; index++) {
+		if (table->active_reg_flows[index] & ~table->active_dflt_flows[index])
+			return true;
+	}
+	return false;
+}
+
+int
+bnxt_ulp_native_group_miss_set(struct rte_eth_dev *dev, uint32_t group_id,
+			     const struct rte_flow_group_attr *attr,
+			     const struct rte_flow_action actions[],
+			     struct rte_flow_error *error)
+{
+	struct bnxt_ulp_context *ctx = bnxt_ulp_eth_dev_ptr2_cntxt_get(dev);
+	const struct rte_flow_action_port_id *destination;
+	struct rte_flow_attr flow_attr = { .transfer = 1 };
+	struct bnxt_ulp_grp_rule_info *info;
+	struct bnxt_representor *vfr = NULL;
+	struct rte_eth_dev *kernel_dev;
+	struct bnxt *bp;
+	uint16_t fid;
+	uint32_t flow_id;
+	int rc;
+
+	if (!attr || !actions)
+		return rte_flow_error_set(error, EINVAL,
+			RTE_FLOW_ERROR_TYPE_UNSPECIFIED, NULL, "Missing group arguments");
+	if (group_id || !attr->transfer || attr->ingress || attr->egress)
+		return rte_flow_error_set(error, ENOTSUP, RTE_FLOW_ERROR_TYPE_ATTR,
+			attr, "Native fallback supports only transfer group 0");
+	if (rte_eth_dev_is_repr(dev) || !ctx || !ctx->cfg_data ||
+	    !ctx->cfg_data->flow_db || ctx->tfo_type != BNXT_ULP_TFO_TYPE_TF)
+		return rte_flow_error_set(error, ENOTSUP,
+			RTE_FLOW_ERROR_TYPE_UNSPECIFIED, NULL, "A TF controller is required");
+	bp = dev->data->dev_private;
+	if (!dev->data->dev_started || !BNXT_CHIP_P5(bp) || ctx->cfg_data->app_id ||
+	    (!BNXT_PF(bp) && !BNXT_VF_IS_TRUSTED(bp)) ||
+	    ctx->cfg_data->ref_cnt != 1)
+		return rte_flow_error_set(error, ENOTSUP,
+			RTE_FLOW_ERROR_TYPE_UNSPECIFIED, NULL,
+			"Native fallback requires one Thor app 0 controller");
+	if (actions[0].type != RTE_FLOW_ACTION_TYPE_END) {
+		if (actions[0].type != RTE_FLOW_ACTION_TYPE_PORT_ID ||
+		    !actions[0].conf || actions[1].type != RTE_FLOW_ACTION_TYPE_END)
+			return rte_flow_error_set(error, ENOTSUP,
+				RTE_FLOW_ERROR_TYPE_ACTION, actions,
+				"Native fallback requires one PORT_ID action or END");
+		destination = actions[0].conf;
+		if (destination->original || destination->id >= RTE_MAX_ETHPORTS ||
+		    !rte_eth_dev_is_valid_port(destination->id))
+			return rte_flow_error_set(error, EINVAL,
+				RTE_FLOW_ERROR_TYPE_ACTION_CONF, destination,
+				"Invalid native destination port");
+		kernel_dev = &rte_eth_devices[destination->id];
+		if (!is_bnxt_supported(kernel_dev) || !rte_eth_dev_is_repr(kernel_dev))
+			return rte_flow_error_set(error, ENOTSUP,
+				RTE_FLOW_ERROR_TYPE_ACTION_CONF, destination,
+				"Native destination must be a BNXT VF representor");
+		vfr = kernel_dev->data->dev_private;
+		if (vfr->parent_dev != dev || BNXT_REP_PF(vfr) ||
+		    BNXT_REP_BASED_PF(vfr) || vfr->role != RTE_PMD_BNXT_REP_ROLE_KERNEL ||
+		    !vfr->registration_only || !kernel_dev->data->dev_started ||
+		    vfr->fw_fid == bp->fw_fid ||
+		    ulp_port_db_port_func_id_get(ctx, destination->id, &fid) ||
+		    fid != vfr->fw_fid)
+			return rte_flow_error_set(error, EINVAL,
+				RTE_FLOW_ERROR_TYPE_ACTION_CONF, destination,
+				"Native destination must be a registered kernel VF on this controller");
+	}
+	rc = bnxt_ulp_cntxt_acquire_fdb_lock(ctx);
+	if (rc)
+		return rte_flow_error_set(error, EBUSY,
+			RTE_FLOW_ERROR_TYPE_UNSPECIFIED, NULL, "Flow database lock failed");
+	info = &ctx->cfg_data->df_rule_info[dev->data->port_id].grp_df_rule[0];
+	if (info->valid) {
+		if (info->kernel_fallback && info->kernel_remove_failed) {
+			bnxt_ulp_cntxt_release_fdb_lock(ctx);
+			return rte_flow_error_set(error, EIO,
+				RTE_FLOW_ERROR_TYPE_UNSPECIFIED, NULL,
+				"Native fallback deletion failed; its consumed FDB handle cannot be retried");
+		}
+		if (!info->kernel_fallback || (vfr &&
+		    (info->kernel_port_id != vfr->dpdk_port_id ||
+		     info->kernel_fid != vfr->fw_fid))) {
+			rc = -EBUSY;
+			goto done;
+		}
+		if (vfr) {
+			rc = 0;
+			goto done;
+		}
+		if (bnxt_ulp_native_miss_has_dependents(ctx)) {
+			rc = -EBUSY;
+			goto done;
+		}
+		rc = ulp_mapper_flow_destroy(ctx, BNXT_ULP_FDB_TYPE_DEFAULT,
+					     info->flow_id, NULL);
+		if (!rc)
+			memset(info, 0, sizeof(*info));
+		else
+			info->kernel_remove_failed = true;
+	} else if (vfr) {
+		if (bnxt_ulp_native_miss_has_dependents(ctx)) {
+			rc = -EBUSY;
+			goto done;
+		}
+		rc = bnxt_ulp_grp_miss_act_set_locked(dev, &flow_attr, actions, &flow_id);
+		if (!rc) {
+			info->group_id = 0;
+			info->flow_id = flow_id;
+			info->dir = BNXT_ULP_DIR_INGRESS;
+			info->kernel_port_id = vfr->dpdk_port_id;
+			info->kernel_fid = vfr->fw_fid;
+			info->kernel_fallback = true;
+			info->valid = true;
+		}
+	} else {
+		rc = 0;
+	}
+done:
+	bnxt_ulp_cntxt_release_fdb_lock(ctx);
+	if (rc)
+		return rte_flow_error_set(error, -rc,
+			RTE_FLOW_ERROR_TYPE_UNSPECIFIED, NULL,
+			"Native fallback update failed; drain regular rules before removal or installation");
+	return 0;
+}
+
+int
+bnxt_ulp_native_miss_rep_busy(struct bnxt_representor *vfr, bool role_change)
+{
+	struct bnxt *bp;
+	struct bnxt_ulp_context *ctx;
+	struct bnxt_ulp_grp_rule_info *info;
+	uint16_t port;
+	int rc;
+
+	if (!vfr->parent_dev || !vfr->parent_dev->data ||
+	    !vfr->parent_dev->data->dev_private)
+		return 0;
+	bp = vfr->parent_dev->data->dev_private;
+	ctx = bp->ulp_ctx;
+	if (!ctx || !ctx->cfg_data)
+		return 0;
+	rc = bnxt_ulp_cntxt_acquire_fdb_lock(ctx);
+	if (rc)
+		return rc;
+	if (role_change && ctx->cfg_data->flow_db &&
+	    bnxt_ulp_native_miss_has_dependents(ctx)) {
+		bnxt_ulp_cntxt_release_fdb_lock(ctx);
+		return -EBUSY;
+	}
+	for (port = 0; port < RTE_MAX_ETHPORTS; port++) {
+		info = &ctx->cfg_data->df_rule_info[port].grp_df_rule[0];
+		if (info->valid && info->kernel_fallback &&
+		    info->kernel_port_id == vfr->dpdk_port_id &&
+		    info->kernel_fid == vfr->fw_fid) {
+			rc = -EBUSY;
+			break;
+		}
+	}
+	bnxt_ulp_cntxt_release_fdb_lock(ctx);
+	return rc;
+}
+
+int
+bnxt_ulp_native_miss_cleanup(struct bnxt *bp)
+{
+	struct bnxt_ulp_context *ctx = bp->ulp_ctx;
+	struct bnxt_ulp_grp_rule_info *info;
+	struct rte_flow_group_attr attr = { .transfer = 1 };
+	const struct rte_flow_action actions[] = {
+		{ .type = RTE_FLOW_ACTION_TYPE_END }
+	};
+
+	if (!ctx || !ctx->cfg_data)
+		return 0;
+	info = &ctx->cfg_data->df_rule_info[bp->eth_dev->data->port_id].grp_df_rule[0];
+	if (!info->valid || !info->kernel_fallback)
+		return 0;
+	if (ctx->cfg_data->ref_cnt != 1)
+		return -EBUSY;
+	return bnxt_ulp_native_group_miss_set(bp->eth_dev, 0, &attr, actions, NULL);
+}
+
