 /** Query a flow rule. */
 int
 port_flow_query(portid_t port_id, uint64_t rule,
@@ -4240,6 +4337,8 @@ port_flow_query(portid_t port_id, uint64_t rule,
 	    port_id == (portid_t)RTE_PORT_ALL)
 		return -EINVAL;
 	port = &ports[port_id];
+	if (action->type == RTE_FLOW_ACTION_TYPE_COUNT && getenv("BNXT_COUNTER_POC"))
+		return counter_poc_sweep(port_id);
 	for (pf = port->flow_list; pf; pf = pf->next)
 		if ((is_user_id ? pf->user_id : pf->id) == rule)
 			break;
