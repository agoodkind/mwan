+	PMD_DRV_LOG_LINE(NOTICE,
+		"VNIC_DIAG stage=%s query=FUNC_VF_VNIC_IDS_QUERY vf_id=%u count=%u",
+		stage, BNXT_REP_VNIC_DIAG_FID, *count);
+	HWRM_UNLOCK();
+	if (*count > BNXT_REP_VNIC_DIAG_MAX_IDS)
+		return -EOVERFLOW;
+	rte_io_rmb();
+	return 0;
+}
+
+static void
+bnxt_hwrm_rep_rx_diag_vnics(struct bnxt *bp, struct bnxt_representor *rep,
+			  const char *stage)
+{
+	uint32_t *vnic_ids, count = 0, index;
+	rte_iova_t table_iova;
+	uint32_t vnic_id;
+	int rc;
+
+	if (!bp->parent || bp->parent->fid == BNXT_PF_FID_INVALID ||
+	    bp->parent->fid > 0xfff8) {
+		PMD_DRV_LOG_LINE(NOTICE,
+			"VNIC_DIAG stage=%s actual-parent-PF-unavailable enumeration-skipped",
+			stage);
+		return;
+	}
+	PMD_DRV_LOG_LINE(NOTICE,
+		"VNIC_DIAG stage=%s controller_fid=%u actual_parent_pf_fid=%u vf_id=%u",
+		stage, bp->fw_fid, bp->parent->fid, BNXT_REP_VNIC_DIAG_FID);
+	if (rep->fw_fid != BNXT_REP_VNIC_DIAG_FID) {
+		PMD_DRV_LOG_LINE(NOTICE,
+			"VNIC_DIAG stage=%s fid=%u expected_fid=%u enumeration-skipped",
+			stage, rep->fw_fid, BNXT_REP_VNIC_DIAG_FID);
+		return;
+	}
+	/* Firmware writes each VNIC ID as a 32-bit little-endian value. */
+	vnic_ids = rte_zmalloc("bnxt_rep_vnic_diag",
+			       BNXT_REP_VNIC_DIAG_MAX_IDS * sizeof(*vnic_ids),
+			       RTE_CACHE_LINE_SIZE);
+	if (!vnic_ids) {
+		PMD_DRV_LOG_LINE(NOTICE, "VNIC_DIAG stage=%s DMA allocation failed",
+				 stage);
+		return;
+	}
+	table_iova = rte_malloc_virt2iova(vnic_ids);
+	if (table_iova == RTE_BAD_IOVA) {
+		PMD_DRV_LOG_LINE(NOTICE, "VNIC_DIAG stage=%s DMA mapping failed",
+				 stage);
+		rte_free(vnic_ids);
+		return;
+	}
+	rc = bnxt_hwrm_rep_rx_diag_vnic_ids(bp, stage, table_iova, &count);
+	if (rc) {
+		PMD_DRV_LOG_LINE(NOTICE, "VNIC_DIAG stage=%s enumeration_rc=%d",
+				 stage, rc);
+		rte_free(vnic_ids);
+		return;
+	}
+	for (index = 0; index < count; index++) {
+		vnic_id = rte_le_to_cpu_32(vnic_ids[index]);
+		PMD_DRV_LOG_LINE(NOTICE,
+			"VNIC_DIAG stage=%s vf_id=%u entry=%u vnic_id=%u",
+			stage, BNXT_REP_VNIC_DIAG_FID, index, vnic_id);
+		rc = bnxt_hwrm_rep_rx_diag_vnic_qcfg(bp, stage, vnic_id);
+		PMD_DRV_LOG_LINE(NOTICE,
+			"VNIC_DIAG stage=%s query=VNIC_QCFG vf_id=%u vnic_id=%u rc=%d",
+			stage, BNXT_REP_VNIC_DIAG_FID, vnic_id, rc);
+	}
+	rte_free(vnic_ids);
+}
+
+void
+bnxt_hwrm_rep_rx_diag(struct bnxt *bp, struct bnxt_representor *rep,
+			const char *stage)
+{
+	int rc;
+
+	if (!getenv("BNXT_REP_RX_DIAG"))
+		return;
+	rc = bnxt_hwrm_rep_rx_diag_func(bp, rep, stage);
+	PMD_DRV_LOG_LINE(NOTICE,
+		"RX_DIAG stage=%s query=FUNC_QCFG fid=%u rc=%d",
+		stage, rep->fw_fid, rc);
+	rc = bnxt_hwrm_rep_rx_diag_pair(bp, rep, stage);
+	PMD_DRV_LOG_LINE(NOTICE,
+		"RX_DIAG stage=%s query=CFA_PAIR_INFO vf=%u rc=%d",
+		stage, rep->vf_id, rc);
+	bnxt_hwrm_rep_rx_diag_vnics(bp, rep, stage);
+}
