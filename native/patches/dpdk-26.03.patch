+static int32_t
+ulp_rte_gre_rx_raw_decap_act_handler(const struct rte_flow_action *action_item,
+				  struct ulp_rte_parser_params *params)
+{
+	const struct rte_flow_action_raw_decap *raw = action_item->conf;
+	struct rte_ether_hdr eth;
+	struct rte_ipv4_hdr ipv4;
+	struct rte_flow_item_gre gre;
