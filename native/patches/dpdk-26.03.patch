+int32_t
+bnxt_pmd_get_represented_mac(uint16_t controller_port_id,
+			     uint16_t represented_port_id,
+			     struct rte_ether_addr *mac)
+{
+	struct rte_eth_dev *controller, *represented;
+	struct bnxt_representor *rep;
+	struct bnxt *bp;
+
+	if (!mac)
+		return -EINVAL;
+	if (!rte_eth_dev_is_valid_port(controller_port_id) ||
+	    !rte_eth_dev_is_valid_port(represented_port_id))
+		return -ENODEV;
+
+	controller = &rte_eth_devices[controller_port_id];
+	represented = &rte_eth_devices[represented_port_id];
+	if (!controller->device || !controller->device->driver ||
+	    !represented->device || !represented->device->driver)
+		return -ENODEV;
+	if (!is_bnxt_supported(controller) || !is_bnxt_supported(represented))
+		return -ENOTSUP;
+	if (rte_eth_dev_is_repr(controller) || !rte_eth_dev_is_repr(represented))
+		return -EINVAL;
+	if (!controller->data->dev_private || !represented->data->dev_private)
+		return -ENODEV;
+
+	rep = represented->data->dev_private;
+	if (BNXT_REP_PF(rep) || rep->parent_dev != controller)
+		return -EINVAL;
+	bp = controller->data->dev_private;
+	if (!(BNXT_PF(bp) || BNXT_VF_IS_TRUSTED(bp)))
+		return -EACCES;
+	if (rep->fw_fid == bp->fw_fid)
+		return -EINVAL;
+
+	return bnxt_hwrm_func_qcfg_mac_addr(bp, rep->fw_fid, mac);
+}
