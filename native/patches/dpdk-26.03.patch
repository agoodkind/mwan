+static int
+bnxt_hwrm_aging_poc_qcaps(struct bnxt *bp, uint8_t direction)
+{
+	struct hwrm_cfa_flow_aging_qcaps_input req = {0};
+	struct hwrm_cfa_flow_aging_qcaps_output *resp = bp->hwrm_cmd_resp_addr;
+	uint16_t status, length;
+	uint8_t valid = 0;
+	int rc;
+
+	HWRM_PREP(&req, HWRM_CFA_FLOW_AGING_QCAPS, BNXT_USE_CHIMP_MB);
+	req.flags = direction;
+	rc = bnxt_hwrm_send_message(bp, &req, sizeof(req), BNXT_USE_CHIMP_MB);
+	status = rte_le_to_cpu_16(resp->error_code);
+	length = rte_le_to_cpu_16(resp->resp_len);
+	if (length && length <= bp->max_resp_len)
+		valid = ((const uint8_t *)resp)[length - 1];
+	PMD_DRV_LOG_LINE(NOTICE,
+		"AGING_POC QCAPS port=%u fid=%u direction=%s transport=%d firmware=%u response_length=%u valid=%u",
+		bp->eth_dev->data->port_id, bp->fw_fid,
+		direction ? "rx" : "tx", rc, status, length, valid);
+	if (rc || status || length < sizeof(*resp) || !valid) {
+		PMD_DRV_LOG_LINE(ERR, "AGING_POC QCAPS did not return capabilities");
+		HWRM_UNLOCK();
+		return rc ? rc : -EIO;
+	}
+	PMD_DRV_LOG_LINE(NOTICE,
+		"AGING_POC QCAPS direction=%s max_tcp_timer=%u max_tcp_fin_timer=%u max_udp_timer=%u max_aging_flows=%u",
+		direction ? "rx" : "tx",
+		rte_le_to_cpu_32(resp->max_tcp_flow_timer),
+		rte_le_to_cpu_32(resp->max_tcp_fin_timer),
+		rte_le_to_cpu_32(resp->max_udp_flow_timer),
+		rte_le_to_cpu_32(resp->max_aging_flows));
+	HWRM_UNLOCK();
+	return 0;
+}
