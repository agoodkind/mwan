+	memcpy(&expected_source.a[RTE_IPV6_ADDR_SIZE - sizeof(rte_be32_t)],
+	       &matched_ipv4->hdr.src_addr, sizeof(rte_be32_t));
+	memcpy(&expected_destination.a[RTE_IPV6_ADDR_SIZE - sizeof(rte_be32_t)],
+	       &matched_ipv4->hdr.dst_addr, sizeof(rte_be32_t));
+	if (!rte_ipv6_addr_eq(&expected_source, &ipv6.hdr.src_addr) ||
+	    !rte_ipv6_addr_eq(&expected_destination, &ipv6.hdr.dst_addr))
+		goto unsupported;
+	ulp_rte_enc_eth_hdr_handler(params, &eth);
+	ulp_rte_enc_ipv6_hdr_handler(params, &ipv6);
+	ULP_BITMAP_SET(params->act_bitmap.bits,
+		       BNXT_ULP_ACT_BIT_NAT46_L3_ENCAP);
+	return BNXT_TF_RC_SUCCESS;
+
+unsupported:
+	BNXT_DRV_DBG(ERR, "NAT64 reverse raw_encap requires a 54-byte "
+		     "Ethernet/IPv6 definition with zero-extended matched IPv4 "
+		     "addresses, matched TCP/UDP protocol, TTL minus one, "
+		     "and zero payload length\n");
+	return BNXT_TF_RC_PARSE_ERR;
+}
