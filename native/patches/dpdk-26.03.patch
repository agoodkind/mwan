+int32_t
+ulp_rte_gre_raw_encap_act_handler(const struct rte_flow_action *action_item,
+				struct ulp_rte_parser_params *params)
+{
+	const struct rte_flow_action_raw_encap *raw = action_item->conf;
+	struct rte_flow_item_eth ethernet = { 0 };
+	struct rte_flow_item_ipv4 ipv4 = { 0 };
+	struct rte_flow_item_gre gre;
+	const rte_be16_t cache_port = 0;
+	const uint8_t cache_vni[3] = { 0 };
+	uint32_t device;
+	uint32_t ip_size = rte_cpu_to_be_32(BNXT_ULP_ENCAP_IPV4_SIZE);
+	uint32_t ip_type = rte_cpu_to_be_32(BNXT_ULP_ETH_IPV4);
+	uint64_t headers = params->hdr_bitmap.bits;
+	uint64_t required_headers = BNXT_ULP_HDR_BIT_O_ETH | BNXT_ULP_HDR_BIT_O_IPV6;
+	uint64_t allowed_headers = BNXT_ULP_HDR_BIT_O_ETH | BNXT_ULP_HDR_BIT_O_IPV6 |
+		BNXT_ULP_HDR_BIT_O_TCP | BNXT_ULP_HDR_BIT_O_UDP | BNXT_ULP_HDR_BIT_O_ICMP;
+	size_t ip_offset = sizeof(ethernet.hdr);
+	size_t gre_offset = ip_offset + sizeof(ipv4.hdr);
+
+	if (bnxt_ulp_cntxt_dev_id_get(params->ulp_ctx, &device) ||
+	    device != BNXT_ULP_DEVICE_ID_THOR) {
+		BNXT_DRV_DBG(ERR, "GRE RAW_ENCAP requires Thor\n");
+		return BNXT_TF_RC_ERROR;
+	}
+	if (!raw || !raw->data || raw->preserve ||
+	    raw->size != gre_offset + sizeof(gre)) {
+		BNXT_DRV_DBG(ERR, "GRE RAW_ENCAP requires Ethernet/IPv4/GRE\n");
+		return BNXT_TF_RC_ERROR;
+	}
+	if ((headers & required_headers) != required_headers ||
+	    (headers & ~allowed_headers)) {
+		BNXT_DRV_DBG(ERR, "GRE RAW_ENCAP requires untagged Ethernet/IPv6\n");
+		return BNXT_TF_RC_ERROR;
+	}
+	if (ULP_COMP_FLD_IDX_RD(params, BNXT_ULP_CF_IDX_DIRECTION) !=
+	    BNXT_ULP_DIR_EGRESS) {
+		BNXT_DRV_DBG(ERR, "GRE RAW_ENCAP requires egress direction\n");
+		return BNXT_TF_RC_ERROR;
+	}
+	if (!ULP_BITMAP_ISSET(params->act_bitmap.bits, BNXT_ULP_ACT_BIT_L2_DECAP) ||
+	    ULP_BITMAP_ISSET(params->act_bitmap.bits, BNXT_ULP_ACT_BIT_GRE_ENCAP)) {
+		BNXT_DRV_DBG(ERR, "GRE RAW_ENCAP requires one preceding RAW_DECAP\n");
+		return BNXT_TF_RC_ERROR;
+	}
+	memcpy(&ethernet.hdr, raw->data, sizeof(ethernet.hdr));
+	memcpy(&ipv4.hdr, raw->data + ip_offset, sizeof(ipv4.hdr));
+	memcpy(&gre, raw->data + gre_offset, sizeof(gre));
+	if (ethernet.hdr.ether_type != rte_cpu_to_be_16(RTE_ETHER_TYPE_IPV4) ||
+	    ipv4.hdr.version_ihl != RTE_IPV4_VHL_DEF ||
+	    ipv4.hdr.next_proto_id != IPPROTO_GRE ||
+	    ipv4.hdr.time_to_live != BNXT_ULP_DEFAULT_TTL ||
+	    ipv4.hdr.type_of_service || ipv4.hdr.packet_id ||
+	    ipv4.hdr.fragment_offset || ipv4.hdr.total_length || ipv4.hdr.hdr_checksum ||
+	    gre.c_rsvd0_ver || gre.protocol != rte_cpu_to_be_16(RTE_ETHER_TYPE_IPV6)) {
+		BNXT_DRV_DBG(ERR, "GRE RAW_ENCAP requires fixed unkeyed IPv6 GRE\n");
+		return BNXT_TF_RC_ERROR;
+	}
+	ulp_rte_enc_eth_hdr_handler(params, &ethernet);
+	ulp_rte_enc_ipv4_hdr_handler(params, &ipv4);
+	/* Use zero UDP and VNI values in the shared tunnel cache key. */
+	ulp_rte_parser_fld_copy(&params->enc_field[BNXT_ULP_ENC_FIELD_UDP_SPORT],
+				&cache_port, sizeof(cache_port));
+	ulp_rte_parser_fld_copy(&params->enc_field[BNXT_ULP_ENC_FIELD_UDP_DPORT],
+				&cache_port, sizeof(cache_port));
+	ulp_rte_parser_fld_copy(&params->enc_field[BNXT_ULP_ENC_FIELD_VXLAN_VNI],
+				cache_vni, sizeof(cache_vni));
+	memcpy(&params->act_prop.act_details[BNXT_ULP_ACT_PROP_IDX_ENCAP_IP_SZ],
+	       &ip_size, sizeof(ip_size));
+	memcpy(&params->act_prop.act_details[BNXT_ULP_ACT_PROP_IDX_ENCAP_L3_TYPE],
+	       &ip_type, sizeof(ip_type));
+	ULP_COMP_FLD_IDX_WR(params, BNXT_ULP_CF_IDX_ACT_ENCAP_IPV4_FLAG, 1);
+	ULP_BITMAP_SET(params->act_bitmap.bits, BNXT_ULP_ACT_BIT_GRE_ENCAP);
+	return BNXT_TF_RC_SUCCESS;
+}
