+	ULP_BITMAP_SET(params->act_bitmap.bits,
+		       BNXT_ULP_ACT_BIT_NAT64_L3_ENCAP);
+	return BNXT_TF_RC_SUCCESS;
+
+unsupported:
+	BNXT_DRV_DBG(ERR, "NAT64 L3 raw_encap requires Ethernet/IPv4 with "
+		     "the matched TCP or UDP protocol, hop limit minus one, "
+		     "and zero length/checksum fields\n");
+	return BNXT_TF_RC_PARSE_ERR;
+}
