+static int
+bnxt_ulp_rx_dmac_mask_validate(const struct ulp_rte_parser_params *params,
+			       const struct rte_flow_item pattern[],
+			       struct rte_flow_error *error)
+{
+	const struct rte_flow_item_eth *mask;
+	const struct rte_flow_item *item;
+	uint32_t dev_id;
+
+	if (ULP_COMP_FLD_IDX_RD(params, BNXT_ULP_CF_IDX_DIRECTION) !=
+	    BNXT_ULP_DIR_INGRESS)
+		return 0;
+	if (bnxt_ulp_cntxt_dev_id_get(params->ulp_ctx, &dev_id))
+		return rte_flow_error_set(error, EINVAL,
+					  RTE_FLOW_ERROR_TYPE_UNSPECIFIED, NULL,
+					  "Cannot identify flow device");
+	if (dev_id != BNXT_ULP_DEVICE_ID_THOR)
+		return 0;
+
+	for (item = pattern; item->type != RTE_FLOW_ITEM_TYPE_END; item++) {
+		switch (item->type) {
+		case RTE_FLOW_ITEM_TYPE_VOID:
+		case RTE_FLOW_ITEM_TYPE_ANY:
+		case RTE_FLOW_ITEM_TYPE_PORT_ID:
+		case RTE_FLOW_ITEM_TYPE_PORT_REPRESENTOR:
+		case RTE_FLOW_ITEM_TYPE_REPRESENTED_PORT:
+			continue;
+		case RTE_FLOW_ITEM_TYPE_ETH:
+			if (!item->spec)
+				return 0;
+			mask = item->mask;
+			if (!mask)
+				mask = &rte_flow_item_eth_mask;
+			if (rte_is_zero_ether_addr(&mask->hdr.dst_addr) ||
+			    rte_is_broadcast_ether_addr(&mask->hdr.dst_addr))
+				return 0;
+			return rte_flow_error_set(error, ENOTSUP,
+				RTE_FLOW_ERROR_TYPE_ITEM_MASK, mask,
+				"Thor RX supports only exact or wildcard "
+				"outer destination MAC masks");
+		default:
+			/* A packet header before ETH makes that ETH an inner header. */
+			return 0;
+		}
+	}
+	return 0;
+}
