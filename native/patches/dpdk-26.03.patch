+static int32_t
+ulp_rte_nat64_traffic_class_set(struct ulp_rte_parser_params *params)
+{
+	const uint64_t encap_bits = BNXT_ULP_ACT_BIT_NAT64_L3_ENCAP |
+		BNXT_ULP_ACT_BIT_NAT64_UDP_ENCAP;
+	const uint32_t tc_idx = BNXT_ULP_PROTO_HDR_SVIF_NUM +
+		BNXT_ULP_PROTO_HDR_ETH_NUM + 1;
+	const struct rte_flow_item *item = params->pattern;
+	const struct rte_flow_item_ipv6 *ipv6_spec, *ipv6_mask;
+	struct ulp_rte_hdr_field *field = &params->hdr_field[tc_idx];
+	rte_be32_t tc_spec, tc_mask;
+	uint8_t traffic_class;
+
+	if (!(params->act_bitmap.bits &
+	      (encap_bits | BNXT_ULP_ACT_BIT_NAT64_CHAIN)))
+		return BNXT_TF_RC_SUCCESS;
+	while (item && item->type != RTE_FLOW_ITEM_TYPE_IPV6 &&
+	       item->type != RTE_FLOW_ITEM_TYPE_END)
+		item++;
+	if (!item || item->type != RTE_FLOW_ITEM_TYPE_IPV6 ||
+	    !item->spec || !item->mask)
+		goto unsupported;
+	ipv6_spec = item->spec;
+	ipv6_mask = item->mask;
+	traffic_class = BNXT_ULP_GET_IPV6_TC(
+		rte_be_to_cpu_32(ipv6_spec->hdr.vtc_flow));
+	if (BNXT_ULP_GET_IPV6_TC(rte_be_to_cpu_32(ipv6_mask->hdr.vtc_flow)) !=
+	    UINT8_MAX || field->size != sizeof(tc_spec))
+		goto unsupported;
+	if ((params->act_bitmap.bits & encap_bits) &&
+	    params->enc_field[BNXT_ULP_ENC_FIELD_IPV4_TOS].spec[0] !=
+	    traffic_class)
+		goto unsupported;
+
+	/* The validated pattern has one Ethernet header without VLAN tags. */
+	tc_spec = rte_cpu_to_be_32(traffic_class);
+	tc_mask = rte_cpu_to_be_32(UINT8_MAX);
+	memcpy(field->spec, &tc_spec, sizeof(tc_spec));
+	memcpy(field->mask, &tc_mask, sizeof(tc_mask));
+	ulp_rte_parser_field_bitmap_update(params, tc_idx, ULP_PRSR_ACT_DEFAULT);
+	return BNXT_TF_RC_SUCCESS;
+
+unsupported:
+	BNXT_DRV_DBG(ERR, "NAT64 requires an exact 8-bit traffic class "
+		     "and matching IPv4 TOS\n");
+	return BNXT_TF_RC_PARSE_ERR;
+}
