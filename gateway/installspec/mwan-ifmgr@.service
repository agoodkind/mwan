[Unit]
Description=MWAN ifmgr (interface manager) daemon for role %i
Documentation=https://github.com/agoodkind/configs
# The daemon writes provider .link files before udev handles device events.
DefaultDependencies=no
# local-fs.target waits for the /boot/efi device created by udev. This unit
# starts after systemd-remount-fs.service. That service remounts / as writable.
After=systemd-journald.socket systemd-remount-fs.service
Before=systemd-udev-trigger.service systemd-networkd.service shutdown.target
# DefaultDependencies=no removes the usual shutdown ordering.
Conflicts=shutdown.target

[Service]
Type=simple
# The systemd instance name selects the WAN role.
# The secrets file is optional when email delivery is not configured.
EnvironmentFile=-/etc/mwan/secrets.env
ExecStart=/usr/local/bin/mwan ifmgr --role %i
Restart=always
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mwan-ifmgr@%i

# The daemon needs these capabilities:
#   CAP_BPF              - load NPTv6 programs and policy maps
#   CAP_PERFMON          - verify NPTv6 map-value pointer arithmetic
#   CAP_SYS_ADMIN        - inspect surviving NPTv6 programs and maps by kernel ID
#   CAP_NET_ADMIN        - addr/rule/route mutations via netlink
#   CAP_NET_RAW          - ICMPv6 sockets for NDP and connectivity probes,
#                          plus DHCPv4 raw sockets (insomniacslk/dhcp)
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_NET_ADMIN CAP_NET_RAW

# Restrict writes to the paths listed below.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
ProtectControlGroups=true
# PrivateTmp would delay this unit until systemd-tmpfiles-setup.service, which
# waits for local-fs.target and the /boot/efi device.

# The WAN role changes promote_secondaries for DHCPv4 and configures kernel
# router discovery for MWAN-owned IPv6 links.
ProtectKernelTunables=false
# /var/lib/mwan is writable because the npt module's DHCPv6-PD source caches
# each interface's delegated prefix in /var/lib/mwan/pd-<iface>.
#
# The wanconfig publish opens a sysrepo connection, which writes lock and
# state files under the repository directory; the leading dash skips the
# entry on hosts without the wanconfig stack (sysrepo's shared memory under
# /dev/shm is already writable, since ProtectSystem leaves /dev alone).
#
# StateDirectory creates /var/lib/mwan before the service starts and adds the
# mount dependency for that path.
StateDirectory=mwan
ReadWritePaths=/var/log /var/run /run /var/lib/mwan /etc/systemd/network /proc/sys/net/ipv4/conf /proc/sys/net/ipv6/conf -/etc/sysrepo
# The sysrepo repository uses group sysrepo and umask 007. The daemon joins
# group sysrepo to read and write repository files.
SupplementaryGroups=sysrepo

[Install]
WantedBy=multi-user.target
