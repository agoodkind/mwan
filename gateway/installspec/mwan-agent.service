[Unit]
Description=MWAN gateway agent (gRPC over TCP and optional Unix socket)
Documentation=https://github.com/agoodkind/configs
After=network.target
Wants=network.target

[Service]
Type=simple
# The secrets file supplies SMTP2GO_API_KEY when email is configured.
# The leading dash lets the gateway start when email credentials are absent.
EnvironmentFile=-/etc/mwan/secrets.env
ExecStart=/usr/local/bin/mwan agent
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mwan-agent

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log /var/run

[Install]
WantedBy=multi-user.target
