{
  "ietf-interfaces:interfaces": {
    "interface": [
      {
        "name": "enisp0",
        "type": "iana-if-type:other",
        "goodkind-mwan-steering:link-files": "hand-authored",
        "ietf-ip:ipv4": {
          "goodkind-mwan-steering:translation": { "mode": "ietf-nat:napt44" }
        },
        "goodkind-mwan-steering:wan": {
          "name": "isp",
          "table-id": 100,
          "fw-mark": 1,
          "fw-mark-prio": 100,
          "from-prio": 55,
          "health": {
            "enabled": true,
            "ping-count": 3,
            "success-threshold": 1,
            "failure-threshold": 2,
            "recovery-threshold": 2,
            "check-interval": 10,
            "targets-v4": ["192.0.2.10"],
            "targets-v6": []
          }
        },
        "goodkind-mwan-steering:steering": {
          "tier": 0,
          "weight": 1
        }
      },
      {
        "name": "tun6in4",
        "type": "iana-if-type:tunnel",
        "goodkind-mwan-steering:connection-id": "tunnel-6in4",
        "goodkind-mwan-steering:owner": "mwan",
        "goodkind-mwan-steering:link": {
          "mtu": 1480,
          "tunnel": {
            "protocol": "6in4",
            "underlay": "enisp0",
            "remote-address": "198.51.100.1",
            "local-address": "192.0.2.130",
            "ttl": 64
          }
        },
        "ietf-ip:ipv6": {
          "address": [{ "ip": "2001:db8:6::2", "prefix-length": 64 }],
          "goodkind-mwan-steering:translation": { "mode": "native" }
        },
        "goodkind-mwan-steering:wan": {
          "name": "tunnel",
          "table-id": 200,
          "fw-mark": 2,
          "fw-mark-prio": 200,
          "from-prio": 56,
          "health": {
            "enabled": true,
            "ping-count": 3,
            "success-threshold": 1,
            "failure-threshold": 2,
            "recovery-threshold": 2,
            "check-interval": 10,
            "targets-v6": ["2001:db8:53::1"]
          },
          "bgp-session": [
            {
              "name": "vps",
              "peer-address": "2001:db8:6::1",
              "peer-port": 179,
              "local-address": "2001:db8:6::2",
              "local-as": 64512,
              "remote-as": 64512,
              "router-id": "192.0.2.130",
              "keepalive": 10,
              "hold": 30,
              "route-metric": 300,
              "import": [{ "prefix": "2001:db8:50::/44", "min-length": 44, "max-length": 48 }],
              "export": [
                {
                  "prefix": "2001:db8:b01::/60",
                  "mode": "always",
                  "next-hop": "2001:db8:6::2",
                  "local-preference": 200
                }
              ]
            }
          ]
        },
        "goodkind-mwan-steering:steering": {
          "tier": 0,
          "weight": 1
        }
      },
      { "name": "enmwanbr0", "type": "iana-if-type:other" },
      { "name": "enmgmt0", "type": "iana-if-type:other" }
    ],
    "goodkind-mwan-steering:steering-group": {
      "hash-mode": "source",
      "reserved-tables": [400, 500],
      "translation": {
        "internal-prefix": "2001:db8:b01::/60",
        "opnsense-edge-v6": "2001:db8:b01:fe::2",
        "mwanbr-edge-v6": "2001:db8:b01:fe::3"
      },
      "routes": {
        "internal-iface": "enmwanbr0",
        "internal-net-v4": "192.0.2.0/29"
      },
      "firewall": {
        "management-interface": "enmgmt0",
        "management-service": [{ "protocol": "tcp", "port": 22 }],
        "pinned-set-v4-name": "isp_pinned_v4",
        "pinned-set-v6-name": "isp_pinned_v6"
      },
      "health": { "probe-timeout": 2000 }
    }
  }
}
